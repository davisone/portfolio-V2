---
import LanguageSwitcher from './LanguageSwitcher.astro'
import { getTranslations, getLocalizedPath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'fr' } = Astro.props
const t = getTranslations(locale)

const navLinks = [
  { name: t.nav.links.home, href: getLocalizedPath('/', locale) },
  { name: t.nav.links.services, href: '/services/' },
  { name: t.nav.links.blog, href: '/blog/' },
  { name: t.nav.links.faq, href: '/faq/' },
  { name: t.nav.links.contact, href: getLocalizedPath('/', locale) + '#contact' },
]
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent py-5">
  <nav aria-label={t.nav.ariaLabel} class="section-container flex items-center justify-between">
    <!-- Logo -->
    <a href={getLocalizedPath('/', locale)} class="text-xl font-display text-encre">
      Evan<span class="text-point">.</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-signal text-xs tracking-[0.14em] uppercase text-cartel hover:text-point transition-colors duration-300"
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA + Language Switcher -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="https://dvs-web.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="font-signal text-xs tracking-[0.14em] uppercase text-encre border-b border-encre hover:text-point hover:border-point transition-colors duration-300"
      >
        DVS Web &#8599;
      </a>
      <LanguageSwitcher locale={locale} currentPath={Astro.url.pathname} />
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-cartel hover:text-encre p-2 transition-colors cursor-pointer"
      aria-label={t.nav.openMenu}
      aria-expanded="false"
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <!-- Hamburger icon -->
      <svg id="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden bg-cimaise border-b border-filet hidden">
    <ul class="section-container py-4 space-y-4">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block font-signal text-xs tracking-[0.14em] uppercase text-cartel hover:text-point transition-colors py-2"
          >
            {link.name}
          </a>
        </li>
      ))}
      <li class="pt-2 flex items-center justify-between">
        <a
          href="https://dvs-web.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="font-signal text-xs tracking-[0.14em] uppercase text-encre border-b border-encre"
        >
          DVS Web &#8599;
        </a>
        <LanguageSwitcher locale={locale} currentPath={Astro.url.pathname} />
      </li>
    </ul>
  </div>
</header>

<script>
  // Fond du header au défilement : un seul écouteur, le header est relu à chaque
  // événement car le routeur client remplace le DOM à chaque navigation
  const majFond = () => {
    const header = document.getElementById('site-header')
    if (!header) return
    const defile = window.scrollY > 50
    header.classList.toggle('bg-cimaise', defile)
    header.classList.toggle('border-b', defile)
    header.classList.toggle('border-filet', defile)
    header.classList.toggle('py-3', defile)
    header.classList.toggle('bg-transparent', !defile)
    header.classList.toggle('py-5', !defile)
  }
  window.addEventListener('scroll', majFond, { passive: true })

  const lierMenu = () => {
    const menuBtn = document.getElementById('mobile-menu-btn')
    const mobileMenu = document.getElementById('mobile-menu')
    const iconMenu = document.getElementById('icon-menu')
    const iconClose = document.getElementById('icon-close')
    if (!menuBtn || !mobileMenu || !iconMenu || !iconClose || menuBtn.dataset.lie) return
    menuBtn.dataset.lie = 'true'
    let ouvert = false

    const basculer = (etat: boolean) => {
      ouvert = etat
      mobileMenu.classList.toggle('hidden', !ouvert)
      iconMenu.classList.toggle('hidden', ouvert)
      iconClose.classList.toggle('hidden', !ouvert)
      menuBtn.setAttribute('aria-expanded', String(ouvert))
      menuBtn.setAttribute('aria-label', (ouvert ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) ?? '')
    }

    menuBtn.addEventListener('click', () => basculer(!ouvert))
    mobileMenu.querySelectorAll('.mobile-nav-link').forEach((lien) => {
      lien.addEventListener('click', () => basculer(false))
    })
  }

  document.addEventListener('astro:page-load', () => {
    majFond()
    lierMenu()
  })
</script>
