---
import { type Locale, locales, getLocalizedPath } from '../i18n'

interface Props {
  locale: Locale
  currentPath: string
}

const { locale, currentPath } = Astro.props

// Calcule le path de base (sans prefixe de locale)
const basePath = currentPath.replace(/^\/(en-gb|en-us)/, '') || '/'

const localeLabels: Record<Locale, string> = {
  fr: 'FR',
  'en-gb': 'UK',
  'en-us': 'US',
}
---

<div class="flex items-center gap-1">
  {locales.map((loc) => (
    <a
      href={getLocalizedPath(basePath, loc)}
      class:list={[
        'font-mono text-[0.65rem] tracking-[0.1em] uppercase px-1.5 py-0.5 transition-colors duration-300',
        loc === locale
          ? 'text-accent font-medium'
          : 'text-muted hover:text-ink',
      ]}
      aria-label={`Switch to ${loc === 'fr' ? 'French' : loc === 'en-gb' ? 'British English' : 'American English'}`}
      aria-current={loc === locale ? 'page' : undefined}
    >
      {localeLabels[loc]}
    </a>
  ))}
</div>
