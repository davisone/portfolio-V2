---
---

<section id="accueil" class="min-h-screen flex flex-col justify-between py-12 sm:py-16 lg:py-20">
  <div class="section-container flex-1 flex flex-col justify-center">
    <div class="animate-fade-in">
      <!-- Label -->
      <div class="section-label mb-10 sm:mb-14">
        En recherche d'alternance — Chef de projet IT
      </div>

      <!-- Titre geant -->
      <h1 class="font-serif text-[clamp(4rem,10vw,9rem)] font-black leading-[0.9] tracking-tight text-ink mb-0">
        <span class="block">Evan</span>
        <span class="block">
          Davi<em class="italic text-accent">son</em>
        </span>
      </h1>

      <!-- Sous-titre -->
      <p class="font-sans text-lg sm:text-xl text-muted mt-4 mb-0">
        Développeur Fullstack — Rennes, Fondateur de
        <a
          href="https://dvs-web.fr"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:text-accent-hover transition-colors underline underline-offset-4 decoration-accent/40"
        >
          DVS Web
        </a>
      </p>
    </div>

    <!-- Grille editoriale -->
    <div class="animate-fade-in border-t border-border mt-10 sm:mt-14 pt-8 sm:pt-10 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16" style="animation-delay: 0.3s; animation-fill-mode: backwards;">
      <!-- Colonne gauche — description -->
      <p class="font-sans text-base leading-relaxed text-body max-w-lg">
        Passionné par le développement web et mobile, je crée des
        <strong class="text-ink font-medium">applications modernes</strong> avec React,
        Next.js et Flutter. En parallèle, j'accompagne les entreprises via mon activité
        <strong class="text-ink font-medium">freelance</strong>. Je recherche une
        <strong class="text-ink font-medium">alternance en gestion de projet IT</strong>
        pour allier ma vision technique à une approche stratégique et organisationnelle.
      </p>

      <!-- Colonne droite — badge + CTA -->
      <div class="flex flex-col items-start md:items-end justify-end gap-6">
        <span class="font-mono text-xs border border-border px-4 py-2 text-muted tracking-wide">
          Disponible — Bac+3 Sup de Vinci
        </span>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <a href="#contact" class="btn-primary">
            Me contacter &rarr;
          </a>
          <a href="/cv/Evan_Davison_cv.pdf" download class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 14v3h14v-3M10 3v10M6 9l4 4 4-4" />
            </svg>
            Télécharger mon CV
          </a>
        </div>
      </div>
    </div>

    <!-- Social links -->
    <div class="flex items-center gap-4 mt-10 sm:mt-14 animate-fade-in" style="animation-delay: 0.5s; animation-fill-mode: backwards;">
      <a
        href="https://github.com/davisone"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-ink transition-colors p-1"
        aria-label="GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/in/evan-d-766478247"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted hover:text-ink transition-colors p-1"
        aria-label="LinkedIn"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#apropos"
    class="flex justify-center text-muted hover:text-ink transition-colors mt-8 animate-fade-in"
    style="animation-delay: 1s; animation-fill-mode: backwards;"
  >
    <div class="animate-bounce">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 4v12M5 11l5 5 5-5" />
      </svg>
    </div>
  </a>
</section>
