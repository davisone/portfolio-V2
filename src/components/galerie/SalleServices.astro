---
import { getTranslations, type Locale } from '../../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'fr' } = Astro.props
const t = getTranslations(locale)

const serviceHrefs = [
  '/services/creation-site-web-rennes',
  '/services/developpement-application-mobile',
  '/services/refonte-site-web',
  '/services/optimisation-seo',
]

const techNames = [
  'TypeScript', 'JavaScript', 'Python', 'Dart', 'Java', 'PHP',
  'React', 'Vue.js', 'Next.js', 'Node.js', 'Astro', 'Flutter',
  'Tailwind', 'Prisma', 'PostgreSQL', 'MongoDB', 'Supabase', 'Firebase',
  'Docker', 'Git', 'Vercel', 'Google Cloud', 'Stripe', 'Figma',
]
---

<section
  id="services"
  class="salle min-h-screen flex items-center py-24"
  data-salle-x="1" data-salle-y="1"
>
  <div class="salle-contenu section-container w-full">
    <p class="signal-label mb-3">{t.galerie.salle} 2 · {t.services.label}</p>
    <h2 class="font-display text-4xl sm:text-5xl text-encre mb-10 sm:mb-14">
      {t.services.title} <span class="text-point">{t.services.titleEmphasis}</span>
    </h2>

    <!-- Quatre pièces exposées -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {t.services.items.map((service, index) => (
        <a
          href={serviceHrefs[index]}
          itemscope
          itemtype="https://schema.org/Service"
          class="cartel-box group p-6 sm:p-7 transition-colors duration-300 hover:border-point flex flex-col"
        >
          <span class="font-display text-4xl text-filet mb-5 block group-hover:text-point/30 transition-colors duration-300">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 itemprop="name" class="font-signal font-semibold text-sm uppercase tracking-[0.08em] text-encre mb-2">
            {service.title}
          </h3>
          <p itemprop="description" class="font-lecture text-sm text-cartel leading-relaxed flex-1">
            {service.description}
          </p>
          <span class="font-signal text-[11px] text-encre group-hover:text-point uppercase tracking-[0.1em] mt-5 inline-block transition-colors duration-300">
            {t.services.learnMore} &rarr;
          </span>
        </a>
      ))}
    </div>

    <!-- Frise des techniques, comme une liste de médiums -->
    <div class="mt-10 sm:mt-14 border-t border-b border-filet py-4 overflow-hidden">
      <p class="font-signal text-xs uppercase tracking-[0.12em] text-cartel leading-relaxed text-center">
        {techNames.join(' · ')}
      </p>
    </div>
  </div>
</section>
