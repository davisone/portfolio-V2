---
import { getTranslations, type Locale } from '../../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'fr' } = Astro.props
const t = getTranslations(locale)

// Géométrie du plan : miroir des attributs data-salle-* des salles
const E = 44 // échelle px par unité viewport
const M = 8 // marge intérieure
const H = 36 // hauteur d'une pièce
const salles = [
  { id: 'accueil', x: 0, y: 0, l: 1, repere: 'H', nom: t.galerie.hall },
  { id: 'apropos', x: 0, y: 1, l: 1, repere: '1', nom: t.about.title },
  { id: 'services', x: 1, y: 1, l: 1, repere: '2', nom: t.nav.links.services },
  { id: 'projets', x: 2, y: 2, l: 2.5, repere: '3', nom: t.projects.title },
  { id: 'experience', x: 3.5, y: 3, l: 1, repere: '4', nom: t.experience.label },
  { id: 'contact', x: 2.5, y: 3, l: 1, repere: 'S', nom: t.nav.links.contact },
]
const largeurSvg = 4.5 * E + 2 * M
const hauteurSvg = 3 * E + H + 2 * M
---

<nav id="plan-visite" class="plan-visite" aria-label={t.galerie.planLabel} hidden>
  <svg
    width={largeurSvg}
    height={hauteurSvg}
    viewBox={`0 0 ${largeurSvg} ${hauteurSvg}`}
    role="presentation"
  >
    {salles.map((s) => (
      <a href={`#${s.id}`} class="plan-salle" data-salle={s.id} aria-label={`${t.galerie.allerSalle} ${s.nom}`}>
        <rect x={M + s.x * E} y={M + s.y * E} width={s.l * E - 6} height={H} />
        <text x={M + s.x * E + (s.l * E - 6) / 2} y={M + s.y * E + H / 2 + 3} text-anchor="middle">{s.repere}</text>
      </a>
    ))}
    <circle id="plan-visiteur" r="4" cx={M + (E - 6) / 2} cy={M + H / 2} />
  </svg>
</nav>

<script>
  // Le point rouge interpole entre les waypoints du plan selon la progression de la visite
  const E = 44
  const M = 8
  const H = 36
  const plan = document.getElementById('plan-visite')
  const visiteur = document.getElementById('plan-visiteur')

  const geometrie: Record<string, { x: number; y: number; l: number }> = {
    accueil: { x: 0, y: 0, l: 1 },
    apropos: { x: 0, y: 1, l: 1 },
    services: { x: 1, y: 1, l: 1 },
    projets: { x: 2, y: 2, l: 2.5 },
    experience: { x: 3.5, y: 3, l: 1 },
    contact: { x: 2.5, y: 3, l: 1 },
  }

  // Position du point pour un waypoint donné (entrée / fin de salle traversante)
  const pointPour = (id: string) => {
    const fin = id.endsWith('-fin')
    const base = geometrie[fin ? id.slice(0, -4) : id]
    if (!base) return null
    const largeur = base.l * E - 6
    const x = fin ? M + base.x * E + largeur - 12 : M + base.x * E + (base.l > 1 ? 12 : largeur / 2)
    return { x, y: M + base.y * E + H / 2 }
  }

  document.addEventListener('galerie:progress', (e) => {
    const galerie = (window as any).__galerie
    if (!galerie || !visiteur) return
    if (plan?.hidden) plan.hidden = false

    const { progress } = (e as CustomEvent).detail
    const { waypoints, progressions } = galerie
    let i = progressions.findIndex((p: number) => progress <= p)
    if (i <= 0) i = progress > 0 ? progressions.length - 1 : 1
    const pAvant = progressions[i - 1]
    const t = progressions[i] > pAvant ? (progress - pAvant) / (progressions[i] - pAvant) : 1
    const a = pointPour(waypoints[i - 1].id)
    const b = pointPour(waypoints[i].id)
    if (!a || !b) return
    visiteur.setAttribute('cx', String(a.x + (b.x - a.x) * Math.min(Math.max(t, 0), 1)))
    visiteur.setAttribute('cy', String(a.y + (b.y - a.y) * Math.min(Math.max(t, 0), 1)))
  })

  plan?.querySelectorAll<HTMLElement>('.plan-salle').forEach((lien) => {
    lien.addEventListener('click', (e) => {
      e.preventDefault()
      const id = lien.dataset.salle
      if (id) (window as any).__galerie?.allerA(id)
    })
  })
</script>
