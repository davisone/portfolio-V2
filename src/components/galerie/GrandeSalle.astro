---
import Cartel from './Cartel.astro'
import { getTranslations, type Locale } from '../../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'fr' } = Astro.props
const t = getTranslations(locale)

// Données locales des œuvres, descriptions localisées via t.projects.items
const projets = [
  {
    titre: 'DVS Web',
    image: '/projets/2.webp',
    technologies: ['Next.js 14', 'TypeScript', 'Tailwind CSS', 'Framer Motion', 'Resend'],
    lien: 'https://dvs-web.fr',
  },
  {
    titre: 'CV Builder',
    image: '/projets/cv-builder.webp',
    technologies: ['Next.js 16', 'TypeScript', 'OpenAI API', 'Stripe', 'Prisma', 'Supabase'],
    lien: 'https://cv-builder.fr',
  },
  {
    titre: 'Carnet de Sante Animal',
    image: '/projets/carnet-de-sante.webp',
    technologies: ['Flutter', 'Dart', 'Firebase', 'Firestore', 'FL Chart'],
    lien: null,
  },
  {
    titre: 'UseQRaft',
    image: '/projets/3.webp',
    technologies: ['Next.js 16', 'React 19', 'TypeScript', 'PostgreSQL', 'Prisma 7'],
    lien: 'https://useqraft.com',
  },
  {
    titre: 'Haut en Couleur',
    image: '/projets/haut-en-couleur.webp',
    technologies: ['Next.js 16', 'TypeScript', 'Tailwind CSS', 'Vercel KV', 'Leaflet'],
    lien: 'https://haut-en-couleur.fr',
  },
]
---

<section
  id="projets"
  class="salle min-h-screen flex items-center py-24"
  data-salle-x="2" data-salle-y="2" data-salle-largeur="2.5"
>
  <div class="salle-contenu w-full px-4 sm:px-6 lg:px-8">
    <!-- Le mur des œuvres : colonne en fallback, rangée en mode galerie -->
    <div class="salle-rangee flex flex-col gap-12 lg:gap-16">
      <header class="grande-entete w-full max-w-6xl mx-auto">
        <p class="signal-label mb-3">{t.galerie.grandeSalle} · {t.projects.label}</p>
        <h2 class="font-display text-4xl sm:text-5xl text-encre">
          {t.projects.title}
        </h2>
      </header>
      {projets.map((projet, index) => (
        <article class="oeuvre w-full max-w-xl mx-auto shrink-0">
          <div class="relative aspect-[16/10] overflow-hidden bg-oeuvre border border-filet mb-0">
            <img
              src={projet.image}
              alt={`${projet.titre} · ${projet.technologies.slice(0, 3).join(', ')}`}
              loading="lazy"
              decoding="async"
              width="1280"
              height="800"
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>
          <Cartel
            titre={projet.titre}
            medium={t.projects.items[index].description}
            technologies={projet.technologies}
            livre={projet.lien !== null}
            livreLabel={t.galerie.delivered}
            lien={projet.lien}
            lienLabel={t.projects.viewSite}
          />
        </article>
      ))}

      <!-- Sortie de salle : le reste de la collection -->
      <a
        href="https://github.com/davisone"
        target="_blank"
        rel="noopener noreferrer"
        class="oeuvre cartel-box group w-full max-w-xl mx-auto shrink-0 flex flex-col items-center justify-center p-10 text-center hover:border-point transition-colors duration-300 min-h-[200px]"
      >
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="text-cartel mb-4 group-hover:text-encre transition-colors duration-300">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span class="font-signal text-sm text-cartel group-hover:text-encre uppercase tracking-[0.1em] transition-colors duration-300">
          {t.projects.viewMoreGithub} &rarr;
        </span>
      </a>
    </div>
  </div>
</section>
