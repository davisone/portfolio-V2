---
import { getTranslations, type Locale } from '../../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'fr' } = Astro.props
const t = getTranslations(locale)
---

<section
  id="accueil"
  class="salle min-h-screen flex flex-col justify-center py-24 sm:py-28"
  data-salle-x="0" data-salle-y="0"
>
  <div class="salle-contenu section-container w-full">
    <p class="signal-label mb-8 sm:mb-10">{t.galerie.hall} — {t.hero.label}</p>

    <!-- Titre géant -->
    <h1 class="font-display text-[clamp(3.5rem,9vw,8rem)] leading-[0.95] text-encre mb-0">
      <span class="block">Evan</span>
      <span class="block">Davi<span class="text-point">son</span></span>
    </h1>

    <!-- Sous-titre -->
    <p class="font-lecture text-lg sm:text-xl text-cartel mt-4 mb-0">
      {t.hero.subtitle}
      <a
        href="https://dvs-web.fr"
        target="_blank"
        rel="noopener noreferrer"
        class="text-encre hover:text-point transition-colors underline underline-offset-4 decoration-filet"
      >
        DVS Web
      </a>
    </p>

    <!-- Grille éditoriale -->
    <div class="border-t border-filet mt-8 sm:mt-12 pt-6 sm:pt-8 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16">
      <p class="font-lecture text-base leading-relaxed text-encre max-w-lg" set:html={t.hero.description} />

      <div class="flex flex-col items-start md:items-end justify-end gap-5">
        <span class="font-signal text-xs border border-filet px-4 py-2 text-cartel tracking-wide">
          {t.hero.badge}
        </span>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <a href="#contact" class="btn-galerie">
            {t.hero.cta} &rarr;
          </a>
          <a href="/cv/Evan_Davison_cv.pdf" download class="btn-galerie-secondaire">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 14v3h14v-3M10 3v10M6 9l4 4 4-4" />
            </svg>
            {t.hero.downloadCv}
          </a>
        </div>
      </div>
    </div>

    <!-- Réseaux + invitation à visiter -->
    <div class="flex items-center justify-between mt-8 sm:mt-12">
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/davisone"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cartel hover:text-encre transition-colors p-1"
          aria-label="GitHub"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/evan-d-766478247"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cartel hover:text-encre transition-colors p-1"
          aria-label="LinkedIn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        </a>
      </div>

      <a href="#apropos" class="signal-label inline-flex items-center gap-2 hover:text-point transition-colors">
        {t.galerie.suite}
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 4v12M5 11l5 5 5-5" />
        </svg>
      </a>
    </div>
  </div>
</section>
