---
import { getCollection, getEntry } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()

const formattedDate = post.data.pubDate.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const dateModified = post.data.dateModified || post.data.pubDate

const articleImage = post.data.image || 'https://www.evandavison.fr/og-image.jpg'

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": articleImage,
  "author": { "@id": "https://www.evandavison.fr/#person" },
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": dateModified.toISOString(),
  "url": `https://www.evandavison.fr/blog/${post.slug}`,
  "publisher": { "@id": "https://www.evandavison.fr/#person" },
  "inLanguage": "fr-FR",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.evandavison.fr/blog/${post.slug}`
  }
}
---

<Layout
  title={`${post.data.title} | Blog Evan Davison`}
  description={post.data.description}
  canonical={`https://www.evandavison.fr/blog/${post.slug}/`}
  ogImage={articleImage}
  ogType="article"
  keywords={post.data.tags.join(', ')}
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/blog" class="hover:text-encre transition-colors">Blog</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre truncate max-w-[200px]">{post.data.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="section-container py-12 sm:py-16 max-w-3xl">
      <div class="flex flex-wrap gap-2 mb-6">
        {post.data.tags.map(tag => (
          <span class="text-xs px-3 py-1 bg-point/10 text-point font-signal">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-encre mb-6 leading-tight">
        {post.data.title}
      </h1>
      <p class="text-xl text-cartel mb-6 leading-relaxed">
        {post.data.description}
      </p>
      <div class="flex items-center gap-4 text-sm text-cartel">
        <span>Evan Davison</span>
        <span>&middot;</span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      </div>
    </header>

    <!-- Article Content -->
    <article class="section-container max-w-3xl pb-20 prose prose-lg max-w-none
      prose-headings:font-display prose-headings:text-encre prose-headings:font-bold
      prose-p:text-cartel prose-p:leading-relaxed
      prose-a:text-point prose-a:underline prose-a:underline-offset-4
      prose-strong:text-encre prose-strong:font-medium
      prose-li:text-cartel
      prose-blockquote:border-point prose-blockquote:text-cartel
      prose-code:text-point prose-code:bg-oeuvre prose-code:px-1.5 prose-code:py-0.5 prose-code:font-signal prose-code:text-sm
      prose-pre:bg-oeuvre prose-pre:border prose-pre:border-filet
      prose-hr:border-filet
    ">
      <Content />
    </article>

    <!-- Nav bas de page -->
    <section class="border-t border-filet py-12">
      <div class="section-container flex flex-wrap justify-between items-center gap-4">
        <a href="/blog" class="btn-secondary">
          &larr; Tous les articles
        </a>
        <a href="/#contact" class="btn-primary">
          Me contacter
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
