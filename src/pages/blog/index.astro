---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const allPosts = await getCollection('blog', ({ data }) => !data.draft)
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog — Evan Davison",
  "description": "Conseils et articles sur le développement web, les technologies modernes et la création de sites à Rennes.",
  "url": "https://evandavison.fr/blog",
  "author": { "@id": "https://evandavison.fr/#person" },
  "inLanguage": "fr-FR"
}
---

<Layout
  title="Blog — Développement Web & Conseils | Evan Davison"
  description="Articles sur le développement web, Next.js, Flutter, SEO et création de sites à Rennes. Conseils pratiques par Evan Davison, développeur fullstack."
  canonical="https://evandavison.fr/blog"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Blog</li>
      </ol>
    </nav>

    <!-- Header -->
    <section class="section-container py-12 sm:py-20">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-ink mb-4">
        Le <em class="text-accent">blog</em>
      </h1>
      <p class="text-xl text-text-body max-w-2xl">
        Développement web, choix techniques, SEO, création de sites à Rennes — des articles concrets pour vous aider à avancer.
      </p>
    </section>

    <!-- Articles -->
    <section class="section-container pb-20">
      {posts.length === 0 ? (
        <p class="text-muted">Aucun article pour l'instant. Revenez bientôt !</p>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map(post => {
            const formattedDate = post.data.pubDate.toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
            return (
              <a
                href={`/blog/${post.slug}`}
                class="border border-border p-6 flex flex-col gap-4 hover:bg-paper-alt transition-colors duration-300"
              >
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="text-xs px-3 py-1 bg-accent/10 text-accent font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-ink font-semibold text-lg leading-snug">
                  {post.data.title}
                </h2>
                <p class="text-text-body text-sm leading-relaxed flex-1">
                  {post.data.description}
                </p>
                <time class="text-muted text-xs" datetime={post.data.pubDate.toISOString()}>
                  {formattedDate}
                </time>
              </a>
            )
          })}
        </div>
      )}
    </section>

  </main>

  <Footer />
</Layout>
