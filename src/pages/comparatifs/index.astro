---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.jsx'
import Footer from '../../components/Footer.astro'

const comparatifs = [
  {
    title: 'WordPress vs code sur mesure',
    description: 'Comparatif complet entre WordPress et le developpement sur mesure : performances, securite, SEO, cout et evolutivite.',
    href: '/comparatifs/wordpress-vs-sur-mesure'
  },
  {
    title: 'Shopify vs WooCommerce vs sur mesure',
    description: 'Quel e-commerce choisir ? Comparatif detaille entre Shopify, WooCommerce et une solution sur mesure selon votre profil.',
    href: '/comparatifs/shopify-vs-woocommerce-vs-sur-mesure'
  }
]

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Comparatifs — Evan Davison",
      "description": "Comparatifs detailles pour choisir la meilleure solution web : WordPress vs sur mesure, Shopify vs WooCommerce, et plus.",
      "url": "https://evandavison.fr/comparatifs",
      "author": { "@id": "https://evandavison.fr/#person" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Comparatifs", "item": "https://evandavison.fr/comparatifs" }
      ]
    }
  ]
}
---

<Layout
  title="Comparatifs web : WordPress, Shopify, sur mesure | Evan Davison"
  description="Comparez les solutions web pour votre projet : WordPress vs code sur mesure, Shopify vs WooCommerce. Guides detailles par un developpeur freelance a Rennes."
  canonical="https://evandavison.fr/comparatifs"
  schema={schema}
>
  <Header client:load />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Comparatifs</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-12 sm:py-20">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-ink mb-6 leading-tight">
        <em class="text-accent">Comparatifs</em> web
      </h1>
      <p class="text-xl text-text-body max-w-2xl leading-relaxed">
        Vous hesitez entre plusieurs solutions pour votre projet ? Ces comparatifs detailles vous aident a faire le bon choix selon vos besoins, votre budget et vos objectifs.
      </p>
    </section>

    <!-- Liste des comparatifs -->
    <section class="section-container pb-16 sm:pb-24">
      <div class="grid sm:grid-cols-2 gap-6">
        {comparatifs.map(item => (
          <a
            href={item.href}
            class="block border border-border p-8 hover:bg-paper-alt transition-colors group"
          >
            <h2 class="font-serif text-xl sm:text-2xl text-ink font-bold mb-3 group-hover:text-accent transition-colors">
              {item.title}
            </h2>
            <p class="text-text-body leading-relaxed">
              {item.description}
            </p>
            <span class="inline-block mt-4 text-accent font-medium text-sm">
              Lire le comparatif &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Liens utiles -->
    <section class="py-12 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <h2 class="font-serif text-2xl font-bold text-ink mb-6">
          Ressources complementaires
        </h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="/faq" class="border border-border p-5 hover:bg-paper transition-colors">
            <span class="font-semibold text-ink block mb-1">FAQ</span>
            <span class="text-text-body text-sm">Toutes les reponses a vos questions</span>
          </a>
          <a href="/blog" class="border border-border p-5 hover:bg-paper transition-colors">
            <span class="font-semibold text-ink block mb-1">Blog</span>
            <span class="text-text-body text-sm">Articles et conseils techniques</span>
          </a>
          <a href="/glossaire" class="border border-border p-5 hover:bg-paper transition-colors">
            <span class="font-semibold text-ink block mb-1">Glossaire</span>
            <span class="text-text-body text-sm">Definitions des termes techniques</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Besoin d'un conseil personnalise ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Chaque projet est unique. Discutons de votre situation pour trouver la solution la plus adaptee.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/services/creation-site-web-rennes" class="btn-secondary">Voir mes services</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
