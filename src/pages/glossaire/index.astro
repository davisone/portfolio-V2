---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const terms = [
  { slug: 'api-rest', name: 'API REST' },
  { slug: 'ssr', name: 'Server-Side Rendering (SSR)' },
  { slug: 'ssg', name: 'Static Site Generation (SSG)' },
  { slug: 'seo', name: 'Search Engine Optimization (SEO)' },
  { slug: 'responsive-design', name: 'Responsive Design' },
  { slug: 'typescript', name: 'TypeScript' },
  { slug: 'react', name: 'React' },
  { slug: 'nextjs', name: 'Next.js' },
  { slug: 'flutter', name: 'Flutter' },
  { slug: 'tailwind-css', name: 'Tailwind CSS' },
  { slug: 'postgresql', name: 'PostgreSQL' },
  { slug: 'prisma', name: 'Prisma ORM' },
  { slug: 'vercel', name: 'Vercel' },
  { slug: 'jamstack', name: 'JAMstack' },
  { slug: 'pwa', name: 'Progressive Web App (PWA)' },
  { slug: 'core-web-vitals', name: 'Core Web Vitals' },
  { slug: 'schema-org', name: 'Schema.org' },
  { slug: 'oauth', name: 'OAuth 2.0' },
  { slug: 'ci-cd', name: 'CI/CD' },
  { slug: 'docker', name: 'Docker' },
  { slug: 'git', name: 'Git' },
  { slug: 'saas', name: 'SaaS' },
  { slug: 'mvp', name: 'MVP (Minimum Viable Product)' },
  { slug: 'ui-ux', name: 'UI/UX Design' },
  { slug: 'cms', name: 'CMS (Content Management System)' },
]

const schema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Glossaire du developpement web",
  "description": "Glossaire des termes techniques du developpement web : definitions, explications et guides pratiques par Evan Davison, developpeur fullstack a Rennes.",
  "url": "https://www.evandavison.fr/glossaire",
  "hasDefinedTerm": terms.map((t) => ({
    "@type": "DefinedTerm",
    "name": t.name,
    "url": `https://www.evandavison.fr/glossaire/${t.slug}`
  }))
}
---

<Layout
  title="Glossaire du developpement web | Evan Davison"
  description="Glossaire complet du developpement web : API REST, SSR, SSG, SEO, React, Next.js, Flutter, TypeScript et plus. Definitions claires par un developpeur fullstack."
  canonical="https://www.evandavison.fr/glossaire"
  schema={schema}
>
  <Header />
  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Glossaire</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-12 sm:py-16">
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-ink mb-6 leading-tight">
        Glossaire du developpement web
      </h1>
      <p class="text-lg text-text-body leading-relaxed max-w-2xl">
        Retrouvez les definitions des termes techniques essentiels du developpement web.
        Chaque notion est expliquee simplement avec des exemples concrets.
      </p>
    </section>

    <!-- Liste des termes -->
    <section class="section-container pb-16 sm:pb-24">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {terms.map((term) => (
          <a
            href={`/glossaire/${term.slug}`}
            class="block border border-border p-5 hover:bg-paper-alt transition-colors group"
          >
            <span class="font-serif text-lg text-ink group-hover:text-accent transition-colors">
              {term.name}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="section-container pb-16 sm:pb-24 border-t border-border pt-12">
      <h2 class="font-serif text-2xl font-bold text-ink mb-4">Un terme vous manque ?</h2>
      <p class="text-text-body mb-6">
        Ce glossaire est regulierement enrichi. Si vous avez une question technique sur votre projet,
        n'hesitez pas a me contacter.
      </p>
      <a href="/#contact" class="btn-primary">Me contacter</a>
    </section>

  </main>
  <Footer />
</Layout>
