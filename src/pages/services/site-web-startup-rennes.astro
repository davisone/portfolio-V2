---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web et MVP pour startup à Rennes",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Développement de sites web et MVP pour startups à Rennes : landing page, prototype fonctionnel, scalabilité, analytics et itérations rapides.",
      "url": "https://www.evandavison.fr/services/site-web-startup-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web startup Rennes", "item": "https://www.evandavison.fr/services/site-web-startup-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pouvez-vous développer un MVP fonctionnel rapidement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui. Je travaille en sprints courts pour livrer un MVP fonctionnel en 4 à 6 semaines. L'objectif : valider votre concept avec de vrais utilisateurs le plus vite possible, puis itérer." }
        },
        {
          "@type": "Question",
          "name": "Le code sera-t-il scalable si la startup décolle ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. J'utilise des architectures modernes (Next.js, bases de données scalables, hébergement cloud) pensées pour supporter la croissance. Le code est propre, documenté et prêt à être repris par une équipe technique." }
        },
        {
          "@type": "Question",
          "name": "Intégrez-vous des outils d'analytics et de tracking ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, j'intègre les outils de mesure adaptés à votre stade : Google Analytics, Hotjar, Mixpanel, ou PostHog. Vous mesurez l'acquisition, la rétention et les conversions dès le lancement." }
        },
        {
          "@type": "Question",
          "name": "Travaillez-vous avec des startups en phase d'amorçage ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je connais les contraintes des startups early-stage : budget limité, besoin de rapidité, pivots fréquents. Je propose des forfaits adaptés et une approche itérative qui s'aligne avec votre rythme." }
        },
        {
          "@type": "Question",
          "name": "Quel budget prévoir pour un MVP de startup ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une landing page de validation démarre autour de 800€. Un MVP fonctionnel avec backend et base de données se situe entre 3 000€ et 8 000€ selon la complexité. Le scope est défini ensemble pour rester dans votre budget." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web startup Rennes | Evan Davison · Développeur Web"
  description="Développement de site web et MVP pour startup à Rennes. Landing page, prototype, scalabilité, analytics. Validez votre idée rapidement. Devis gratuit."
  canonical="https://www.evandavison.fr/services/site-web-startup-rennes/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Site web startup Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Du concept au <em class="text-point">MVP</em> :<br/>lancez votre startup a Rennes
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Landing page de validation, prototype fonctionnel, code scalable : je transforme votre idee en produit testable rapidement, avec les bons outils et les bonnes metriques.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Arretez de planifier, commencez a <em class="text-point">tester</em>
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Trop de startups passent des mois a perfectionner leur business plan avant d'avoir un seul utilisateur. La realite : vous ne saurez si votre idee fonctionne qu'en la mettant entre les mains de vrais utilisateurs.</p>
              <p>Un MVP (Minimum Viable Product) n'est pas un produit bacle : c'est la version la plus simple qui permet de valider vos hypotheses. Une landing page qui mesure l'interet, un prototype qui teste le parcours utilisateur, des metriques qui guident les decisions.</p>
              <p>Basé pres de Rennes, je travaille avec des fondateurs de startups, des porteurs de projet et des incubes (Le Poool, Rennes Atalante, French Tech Rennes St-Malo). Je comprends l'urgence de valider vite et d'iterer.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Des startups echouent par manque de marche', value: '42%' },
              { label: 'Delai moyen d\'un MVP', value: '5 sem.' },
              { label: 'Iterations avant product-market fit', value: '3-5' },
              { label: 'Startups a Rennes (French Tech)', value: '500+' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Ce que je developpe pour les <em class="text-point">startups</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Landing page de validation', desc: "Page d'atterrissage optimisee pour tester votre proposition de valeur. Mesure de l'interet via inscriptions, waitlist ou pre-commandes." },
          { title: 'MVP fonctionnel', desc: "Prototype avec les fonctionnalites cles : inscription, parcours utilisateur, backend leger. Assez solide pour de vrais tests, assez leger pour pivoter." },
          { title: 'Architecture scalable', desc: "Code propre avec Next.js, TypeScript, bases de donnees cloud. Pret a supporter 10 ou 10 000 utilisateurs sans refonte majeure." },
          { title: 'Analytics et tracking', desc: "Integration Google Analytics, Hotjar, Mixpanel ou PostHog. Mesurez chaque interaction pour prendre des decisions basees sur les donnees." },
          { title: 'Deploiement continu', desc: "Pipeline CI/CD avec Vercel ou AWS. Chaque modification est deployee automatiquement. Vous iterez vite sans risque technique." },
          { title: 'Documentation technique', desc: "Code commente, README complet, architecture documentee. Votre futur CTO ou votre equipe tech reprend le projet sans perte d'information." },
        ].map(item => (
          <div class="border border-filet p-6">
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Des produits lances, <em class="text-point">pas des slides</em>
        </h2>
        <p class="text-cartel mb-8">Decouvrez des projets realises pour des startups et porteurs de projet.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Questions <em class="text-point">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Pouvez-vous developper un MVP fonctionnel rapidement ?',
            a: 'Oui. Je travaille en sprints courts pour livrer un MVP fonctionnel en 4 a 6 semaines. L\'objectif : valider votre concept avec de vrais utilisateurs le plus vite possible, puis iterer.'
          },
          {
            q: 'Le code sera-t-il scalable si la startup decolle ?',
            a: 'Absolument. J\'utilise des architectures modernes (Next.js, bases de donnees scalables, hebergement cloud) pensees pour supporter la croissance. Le code est propre, documente et pret a etre repris par une equipe technique.'
          },
          {
            q: 'Integrez-vous des outils d\'analytics et de tracking ?',
            a: 'Oui, j\'integre les outils de mesure adaptes a votre stade : Google Analytics, Hotjar, Mixpanel, ou PostHog. Vous mesurez l\'acquisition, la retention et les conversions des le lancement.'
          },
          {
            q: 'Travaillez-vous avec des startups en phase d\'amorcage ?',
            a: 'Oui, je connais les contraintes des startups early-stage : budget limite, besoin de rapidite, pivots frequents. Je propose des forfaits adaptes et une approche iterative qui s\'aligne avec votre rythme.'
          },
          {
            q: 'Quel budget prevoir pour un MVP de startup ?',
            a: 'Une landing page de validation demarre autour de 800 euros. Un MVP fonctionnel avec backend et base de donnees se situe entre 3 000 et 8 000 euros selon la complexite. Le scope est defini ensemble pour rester dans votre budget.'
          },
        ].map(item => (
          <details class="border border-filet p-6 group">
            <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-oeuvre border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Pret a transformer votre idee en produit ?
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Parlons de votre projet et de la meilleure approche pour le lancer. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
