---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web pour plombier à Rennes",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Création de sites web sur mesure pour plombiers à Rennes : demande de devis en ligne, zone d'intervention, urgences et dépannage, optimisation SEO local.",
      "url": "https://www.evandavison.fr/services/site-web-plombier-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web plombier Rennes", "item": "https://www.evandavison.fr/services/site-web-plombier-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment un site web peut-il aider un plombier à trouver des clients ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site web optimisé pour le SEO local vous positionne sur Google quand quelqu'un cherche 'plombier Rennes' ou 'urgence plomberie'. C'est votre vitrine permanente qui génère des appels et demandes de devis, même le week-end." }
        },
        {
          "@type": "Question",
          "name": "Peut-on mettre en avant les interventions d'urgence sur le site ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je crée une section urgences bien visible avec numéro d'appel click-to-call, disponibilités et zones d'intervention. Cette page est optimisée pour les recherches 'plombier urgence Rennes'." }
        },
        {
          "@type": "Question",
          "name": "Le site peut-il afficher la zone d'intervention géographique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Une carte interactive affiche votre zone d'intervention (Rennes et communes alentour) pour que les clients sachent immédiatement si vous intervenez chez eux." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer un formulaire de demande de devis en ligne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je crée un formulaire de demande de devis détaillé (type d'intervention, urgence, photos du problème) qui vous parvient par email ou SMS pour une réponse rapide." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un site web pour un plombier à Rennes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine pour plombier avec demande de devis et SEO local démarre autour de 700 euros. Le prix varie selon les fonctionnalités souhaitées (galerie de réalisations, avis clients, etc.). Devis gratuit sur demande." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web plombier Rennes | Evan Davison — Développeur Web"
  description="Création de site web pour plombier à Rennes : demande de devis, urgences, zone d'intervention, SEO local. Un site qui génère des appels. Devis gratuit."
  canonical="https://www.evandavison.fr/services/site-web-plombier-rennes/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Site web plombier Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Votre activite de <em class="text-accent">plombier</em> merite<br/>d'etre visible en ligne
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Demande de devis, page urgences, zone d'intervention — un site web concu pour generer des appels et des demandes d'intervention a Rennes et ses alentours.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Vos futurs clients tapent <em class="text-accent">"plombier Rennes"</em> dans Google en cas d'urgence
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Selon les donnees Google, les recherches "plombier + ville" ont augmente de 35% ces trois dernieres annees. En situation d'urgence (fuite, canalisation bouchee), le premier reflexe est de chercher sur Google. Si vous n'apparaissez pas dans les premiers resultats, vos concurrents captent ces appels.</p>
              <p>Un site de plombier efficace, c'est un numero de telephone visible et cliquable en un geste, une section urgences qui rassure, une liste claire de vos prestations et une zone d'intervention definie. Le tout reference pour que Google vous affiche en priorite.</p>
              <p>Je concois des sites specifiquement adaptes aux artisans du batiment : navigation ultra-simple sur mobile (vos clients appellent depuis leur telephone), bouton d'appel toujours visible, et referencement local pousse pour dominer les recherches dans votre zone.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Cherchent un artisan en ligne', value: '82%' },
              { label: 'Appellent dans les 24h', value: '70%' },
              { label: 'Hausse recherches "plombier"', value: '+35%' },
              { label: 'Comparent les avis avant', value: '88%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Ce que votre site de <em class="text-accent">plombier</em> inclut
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Bouton d\'appel click-to-call', desc: "Numero de telephone cliquable toujours visible sur mobile. En cas d'urgence, vos clients vous appellent en un seul geste, sans chercher." },
          { title: 'Section urgences et depannage', desc: "Page dediee bien visible avec disponibilites, delais d'intervention et types d'urgences traites. Optimisee pour les recherches 'plombier urgence Rennes'." },
          { title: 'Formulaire de demande de devis', desc: "Formulaire detaille avec type d'intervention, description du probleme et possibilite d'envoyer des photos. Notification par email ou SMS pour repondre vite." },
          { title: 'Zone d\'intervention', desc: "Carte interactive montrant Rennes et les communes ou vous intervenez. Vos clients savent immediatement si vous couvrez leur secteur." },
          { title: 'Liste des prestations', desc: "Presentation claire de vos services : depannage, installation, renovation salle de bain, chauffage, chauffe-eau. Chaque prestation detaillee et referencee." },
          { title: 'Avis clients et realisations', desc: "Temoignages de clients satisfaits et galerie photos de vos interventions. La preuve de votre serieux et de la qualite de votre travail." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Des sites qui generent des <em class="text-accent">appels</em>
        </h2>
        <p class="text-text-body mb-8">Decouvrez des projets realises pour des artisans et professionnels du batiment.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Comment un site web peut-il aider un plombier a trouver des clients ?',
            a: 'Un site web optimise pour le SEO local vous positionne sur Google quand quelqu\'un cherche "plombier Rennes" ou "urgence plomberie". C\'est votre vitrine permanente qui genere des appels et demandes de devis, meme le week-end.'
          },
          {
            q: 'Peut-on mettre en avant les interventions d\'urgence sur le site ?',
            a: 'Oui, je cree une section urgences bien visible avec numero d\'appel click-to-call, disponibilites et zones d\'intervention. Cette page est optimisee pour les recherches "plombier urgence Rennes".'
          },
          {
            q: 'Le site peut-il afficher la zone d\'intervention geographique ?',
            a: 'Absolument. Une carte interactive affiche votre zone d\'intervention (Rennes et communes alentour) pour que les clients sachent immediatement si vous intervenez chez eux.'
          },
          {
            q: 'Peut-on integrer un formulaire de demande de devis en ligne ?',
            a: 'Oui, je cree un formulaire de demande de devis detaille (type d\'intervention, urgence, photos du probleme) qui vous parvient par email ou SMS pour une reponse rapide.'
          },
          {
            q: 'Combien coute un site web pour un plombier a Rennes ?',
            a: 'Un site vitrine pour plombier avec demande de devis et SEO local demarre autour de 700 euros. Le prix varie selon les fonctionnalites souhaitees (galerie de realisations, avis clients, etc.). Devis gratuit sur demande.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Pret a recevoir plus d'appels clients ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre activite et de vos objectifs. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
