---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Optimisation SEO et referencement naturel",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Optimisation SEO technique et referencement naturel",
      "description": "Optimisation SEO technique a Rennes : Core Web Vitals, Schema.org, structure semantique, performances. Ameliorez votre visibilite sur Google durablement.",
      "url": "https://www.evandavison.fr/services/optimisation-seo"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Optimisation SEO", "item": "https://www.evandavison.fr/services/optimisation-seo" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour voir les resultats SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les ameliorations techniques (Core Web Vitals, temps de chargement) sont visibles immediatement. Pour le positionnement sur Google, comptez 2 a 6 mois selon la concurrence sur vos mots-cles. Le SEO technique pose les fondations, les resultats s'accumulent dans le temps." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la difference entre SEO technique et SEO de contenu ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEO technique concerne l'infrastructure du site : vitesse de chargement, structure HTML, donnees structurees, indexation, accessibilite. Le SEO de contenu concerne la qualite et la pertinence des textes. Les deux sont complementaires — un bon contenu sur un site lent ne performe pas." }
        },
        {
          "@type": "Question",
          "name": "Que sont les Core Web Vitals et pourquoi sont-ils importants ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les Core Web Vitals sont trois metriques de Google qui mesurent l'experience utilisateur : LCP (temps de chargement du plus grand element), INP (reactivite aux interactions) et CLS (stabilite visuelle). Depuis 2021, ces metriques influencent directement le positionnement dans les resultats de recherche." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous un audit SEO avant intervention ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, chaque prestation SEO commence par un audit complet : analyse technique du site, performances, structure HTML, balises meta, donnees structurees, profil de liens, et comparaison avec vos concurrents. Cet audit permet de prioriser les actions a fort impact." }
        },
        {
          "@type": "Question",
          "name": "Le SEO est-il inclus dans la creation d'un site web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, le SEO technique est integre dans chaque site que je developpe : HTML semantique, balises meta, Schema.org, sitemap, performances optimisees. La prestation d'optimisation SEO s'adresse aux sites existants qui ont besoin d'un audit et d'ameliorations specifiques." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Optimisation SEO Rennes | Referencement naturel"
  description="Optimisation SEO technique a Rennes. Core Web Vitals, Schema.org, structure semantique, performances. Ameliorez votre positionnement Google durablement. Audit gratuit."
  canonical="https://www.evandavison.fr/services/optimisation-seo/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Optimisation SEO</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          <em class="text-point">Optimisation SEO</em><br/>et referencement naturel
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Votre site n'apparait pas sur Google ? Je mets en place un SEO technique solide — Core Web Vitals, donnees structurees, structure semantique — pour que votre site soit visible la ou vos clients cherchent.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Demander un audit SEO gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes realisations
          </a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Le SEO technique, <em class="text-point">fondation invisible</em> de votre visibilite
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Vous pouvez avoir le meilleur contenu du monde — si votre site est lent, mal structure ou incomprehensible pour Google, personne ne le trouvera.</p>
              <p>Le SEO technique, c'est ce qui se passe sous le capot : la vitesse de chargement mesurable par les Core Web Vitals (LCP, INP, CLS), la structure HTML semantique que Google sait lire, les donnees structurees Schema.org qui enrichissent vos resultats de recherche.</p>
              <p>En tant que developpeur web, j'interviens la ou les agences SEO classiques atteignent leurs limites : directement dans le code. Pas de plugin miracle, pas de promesse vague — des optimisations techniques concretes et mesurables.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Score Lighthouse moyen', value: '95+' },
              { label: 'LCP moyen', value: '<1.5s' },
              { label: 'CLS moyen', value: '<0.05' },
              { label: 'Sites audites', value: '30+' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Piliers SEO -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Les piliers du <em class="text-point">SEO technique</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Core Web Vitals', desc: "Optimisation du LCP (Largest Contentful Paint), INP (Interaction to Next Paint) et CLS (Cumulative Layout Shift). Ces metriques influencent directement votre positionnement Google." },
          { title: 'Schema.org', desc: "Implementation de donnees structurees : Organization, LocalBusiness, Service, FAQPage, BreadcrumbList. Vos resultats Google s'enrichissent de rich snippets visibles." },
          { title: 'HTML semantique', desc: "Structure heading correcte (h1-h6), balises article, section, nav, aside. Google comprend le contenu et la hierarchie de vos pages." },
          { title: 'Performances', desc: "Compression des images (WebP/AVIF), code splitting, lazy loading, preconnect, cache headers. Chaque milliseconde compte pour Google et vos visiteurs." },
          { title: 'Indexation', desc: "Sitemap XML, robots.txt, balises canoniques, redirections 301, gestion du contenu duplique. Google crawle et indexe efficacement votre site." },
          { title: 'SEO local', desc: "Optimisation pour les recherches geolocalisees : balises geo, donnees structurees LocalBusiness, coherence NAP (nom, adresse, telephone) sur le web." },
        ].map(item => (
          <div class="border border-filet p-6">
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
          Ma methode <em class="text-point">SEO</em>
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { step: '01', title: 'Audit', desc: "Analyse technique complete : Lighthouse, Search Console, structure HTML, Schema.org, profil de liens, concurrence." },
            { step: '02', title: 'Priorisation', desc: "Identification des quick wins et des chantiers a moyen terme. Plan d'action ordonne par impact sur le positionnement." },
            { step: '03', title: 'Implementation', desc: "Corrections dans le code : optimisation des performances, balises meta, donnees structurees, redirections, sitemap." },
            { step: '04', title: 'Suivi', desc: "Monitoring des positions et des Core Web Vitals. Rapport mensuel avec les metriques qui comptent." },
          ].map(item => (
            <div class="border border-filet p-6">
              <div class="text-4xl font-display font-black text-filet/50 mb-3">{item.step}</div>
              <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Realisations liees -->
    <section class="section-container py-16 sm:py-24 text-center">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
        Resultats <em class="text-point">SEO</em> concrets
      </h2>
      <p class="text-cartel mb-8">Des sites optimises avec des gains de positionnement mesurables.</p>
      <a href="/#realisations" class="btn-primary">
        Voir toutes mes realisations
      </a>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
          Questions <em class="text-point">frequentes</em>
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {[
            {
              q: 'Combien de temps faut-il pour voir les resultats SEO ?',
              a: "Les ameliorations techniques (Core Web Vitals, temps de chargement) sont visibles immediatement. Pour le positionnement sur Google, comptez 2 a 6 mois selon la concurrence. Le SEO technique pose les fondations, les resultats s'accumulent dans le temps."
            },
            {
              q: 'Quelle est la difference entre SEO technique et SEO de contenu ?',
              a: "Le SEO technique concerne l'infrastructure du site : vitesse, structure HTML, donnees structurees, indexation. Le SEO de contenu concerne la qualite des textes. Les deux sont complementaires — un bon contenu sur un site lent ne performe pas."
            },
            {
              q: 'Que sont les Core Web Vitals et pourquoi sont-ils importants ?',
              a: "Ce sont trois metriques Google mesurant l'experience utilisateur : LCP (temps de chargement), INP (reactivite) et CLS (stabilite visuelle). Depuis 2021, ces metriques influencent directement le positionnement dans les resultats de recherche."
            },
            {
              q: 'Proposez-vous un audit SEO avant intervention ?',
              a: "Oui, chaque prestation commence par un audit complet : analyse technique, performances, structure HTML, balises meta, donnees structurees, profil de liens et comparaison concurrentielle. Cet audit permet de prioriser les actions a fort impact."
            },
            {
              q: 'Le SEO est-il inclus dans la creation d\'un site web ?',
              a: "Oui, le SEO technique est integre dans chaque site que je developpe. La prestation d'optimisation SEO s'adresse aux sites existants qui ont besoin d'un audit et d'ameliorations specifiques."
            },
          ].map(item => (
            <details class="border border-filet p-6 group">
              <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
                {item.q}
                <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Votre site merite d'etre trouve
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Demandez un audit SEO gratuit. On identifie ensemble les optimisations prioritaires.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Demander un audit</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
