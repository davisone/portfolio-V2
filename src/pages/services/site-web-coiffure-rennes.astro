---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web pour salon de coiffure à Rennes",
      "provider": { "@id": "https://evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Création de sites web sur mesure pour salons de coiffure à Rennes : réservation en ligne, galerie avant/après, tarifs et prestations, optimisation SEO local.",
      "url": "https://evandavison.fr/services/site-web-coiffure-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web coiffure Rennes", "item": "https://evandavison.fr/services/site-web-coiffure-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Peut-on intégrer un système de réservation en ligne pour le salon ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, j'intègre des outils comme Planity, Treatwell ou un formulaire sur mesure pour que vos clients réservent un créneau en ligne, 24h/24, en choisissant le coiffeur et la prestation." }
        },
        {
          "@type": "Question",
          "name": "Peut-on afficher une galerie avant/après des réalisations ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Je crée une galerie visuelle avant/après pour mettre en valeur vos coupes, colorations et coiffures. Les photos sont optimisées pour un affichage rapide et professionnel." }
        },
        {
          "@type": "Question",
          "name": "Comment se démarquer des autres salons de coiffure à Rennes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le site met en avant votre identité unique : ambiance du salon, spécialités (coloration végétale, coiffure mariée, barbier), produits utilisés et votre équipe. Combiné au SEO local, vous vous démarquez sur Google." }
        },
        {
          "@type": "Question",
          "name": "Les tarifs des prestations seront-ils faciles à mettre à jour ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, l'interface d'administration vous permet de modifier vos tarifs, ajouter de nouvelles prestations ou ajuster les descriptions en quelques clics, sans aucune compétence technique." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un site web pour un salon de coiffure à Rennes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine pour salon de coiffure avec réservation en ligne et galerie démarre autour de 800 euros. Le prix varie selon les fonctionnalités souhaitées (e-shop produits, programme fidélité, etc.). Devis gratuit sur demande." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web salon de coiffure Rennes | Evan Davison — Développeur Web"
  description="Création de site web pour salon de coiffure à Rennes : réservation en ligne, galerie avant/après, tarifs, SEO local. Un site qui remplit votre carnet de RDV. Devis gratuit."
  canonical="https://evandavison.fr/services/site-web-coiffure-rennes"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Site web coiffure Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Votre salon de <em class="text-accent">coiffure</em> merite<br/>un site a son image
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Reservation en ligne, galerie avant/apres, tarifs clairs — un site web concu pour remplir votre carnet de rendez-vous et refeter l'identite de votre salon a Rennes et ses alentours.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Vos futurs clients veulent voir votre <em class="text-accent">travail</em> avant de prendre rendez-vous
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Selon une etude de la Federation Nationale de la Coiffure, 74% des clients de moins de 45 ans recherchent un salon de coiffure en ligne avant de s'y rendre. Ils veulent voir vos realisations, connaitre vos tarifs et pouvoir reserver facilement.</p>
              <p>Un site de salon de coiffure efficace, c'est une galerie de realisations qui inspire confiance, un systeme de reservation en ligne qui evite les appels manques, une grille tarifaire claire et une presentation de votre equipe et de votre univers.</p>
              <p>Je concois des sites qui refletent l'identite de votre salon : design sur mesure, galerie avant/apres percutante, integration des reseaux sociaux et un parcours de reservation fluide qui fonctionne sur mobile comme sur ordinateur.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Cherchent un coiffeur en ligne', value: '74%' },
              { label: 'Reservent en ligne', value: '58%' },
              { label: 'Consultent les photos avant', value: '82%' },
              { label: 'Decouvrent via Instagram ou Google', value: '69%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Ce que votre site de <em class="text-accent">salon de coiffure</em> inclut
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Reservation en ligne', desc: "Integration Planity, Treatwell ou formulaire sur mesure. Vos clients choisissent le coiffeur, la prestation et le creneau en quelques clics, 24h/24." },
          { title: 'Galerie avant/apres', desc: "Mise en valeur de vos coupes, colorations et coiffures avec un systeme avant/apres visuel. De quoi convaincre les indecis et montrer votre talent." },
          { title: 'Grille tarifaire claire', desc: "Tarifs organises par categorie (femme, homme, enfant, barbe) avec detail des prestations. Modifiable en autonomie depuis l'interface d'administration." },
          { title: 'Presentation de l\'equipe', desc: "Profil de chaque coiffeur avec photo, specialites et experience. Les clients choisissent leur coiffeur en toute confiance avant meme d'entrer dans le salon." },
          { title: 'Integration reseaux sociaux', desc: "Feed Instagram integre pour afficher vos dernieres realisations. Lien vers vos profils sociaux pour developper votre communaute en ligne." },
          { title: 'Produits et soins', desc: "Presentation des gammes de produits utilises et vendus au salon. Possibilite d'ajouter un e-shop pour la vente en ligne de produits capillaires." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Des sites qui ont du <em class="text-accent">style</em>
        </h2>
        <p class="text-text-body mb-8">Decouvrez des projets realises pour des professionnels de la beaute et du bien-etre.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Peut-on integrer un systeme de reservation en ligne pour le salon ?',
            a: 'Oui, j\'integre des outils comme Planity, Treatwell ou un formulaire sur mesure pour que vos clients reservent un creneau en ligne, 24h/24, en choisissant le coiffeur et la prestation.'
          },
          {
            q: 'Peut-on afficher une galerie avant/apres des realisations ?',
            a: 'Absolument. Je cree une galerie visuelle avant/apres pour mettre en valeur vos coupes, colorations et coiffures. Les photos sont optimisees pour un affichage rapide et professionnel.'
          },
          {
            q: 'Comment se demarquer des autres salons de coiffure a Rennes ?',
            a: 'Le site met en avant votre identite unique : ambiance du salon, specialites (coloration vegetale, coiffure mariee, barbier), produits utilises et votre equipe. Combine au SEO local, vous vous demarquez sur Google.'
          },
          {
            q: 'Les tarifs des prestations seront-ils faciles a mettre a jour ?',
            a: 'Oui, l\'interface d\'administration vous permet de modifier vos tarifs, ajouter de nouvelles prestations ou ajuster les descriptions en quelques clics, sans aucune competence technique.'
          },
          {
            q: 'Combien coute un site web pour un salon de coiffure a Rennes ?',
            a: 'Un site vitrine pour salon de coiffure avec reservation en ligne et galerie demarre autour de 800 euros. Le prix varie selon les fonctionnalites souhaitees (e-shop produits, programme fidelite, etc.). Devis gratuit sur demande.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Pret a remplir votre carnet de rendez-vous ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre salon et de vos objectifs. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
