---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Hebergement web",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "Country", "name": "France" },
      "serviceType": "Hebergement de sites web",
      "description": "Hebergement web performant et securise : serveurs rapides, CDN, certificat SSL, sauvegardes automatiques et monitoring uptime. Infrastructure fiable pour votre site.",
      "url": "https://www.evandavison.fr/services/hebergement-web"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Hebergement web", "item": "https://www.evandavison.fr/services/hebergement-web" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ou sont situes les serveurs ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les serveurs sont heberges en France et en Europe, conformes au RGPD. Selon votre audience, je configure un CDN (Content Delivery Network) pour distribuer le contenu au plus pres de vos visiteurs et reduire les temps de chargement." }
        },
        {
          "@type": "Question",
          "name": "Le certificat SSL est-il inclus ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, un certificat SSL est inclus dans toutes les formules. Votre site est accessible en HTTPS, ce qui securise les echanges de donnees et ameliore votre positionnement sur Google." }
        },
        {
          "@type": "Question",
          "name": "Que se passe-t-il en cas de pic de trafic ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les formules Pro et Premium incluent une mise a l'echelle automatique pour absorber les pics de trafic sans degrader les performances. La formule Essentielle dispose de ressources suffisantes pour la majorite des sites vitrines." }
        },
        {
          "@type": "Question",
          "name": "Puis-je migrer mon site existant vers votre hebergement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, la migration est incluse dans toutes les formules. Je m'occupe du transfert des fichiers, de la base de donnees et de la configuration DNS. La migration se fait sans interruption de service." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la garantie de disponibilite ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Je garantis un taux de disponibilite de 99.9% sur toutes les formules. Le monitoring permanent detecte les incidents en temps reel et permet une intervention rapide pour minimiser tout temps d'arret." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Hebergement web | Evan Davison · Developpeur Web Freelance"
  description="Hebergement web performant et securise : serveurs rapides, CDN, SSL, sauvegardes et monitoring. Infrastructure fiable pour votre site. A partir de 19 euros/mois."
  canonical="https://www.evandavison.fr/services/hebergement-web/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Hebergement web</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Hebergement <em class="text-point">web</em><br/>performant
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          La vitesse de votre site influence directement votre taux de conversion et votre referencement. Je vous propose un hebergement optimise, securise et surveille en permanence : pour que votre site soit toujours disponible et rapide.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Demander un devis
          </a>
          <a href="#tarifs" class="btn-secondary">
            Voir les formules
          </a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Un hebergement mediocre <em class="text-point">coute cher</em>
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Chaque seconde de chargement supplementaire fait fuir 7% de vos visiteurs. Un hebergement mutualise bas de gamme, c'est un site lent, des pannes frequentes et un referencement penalise par Google.</p>
              <p>Je selectionne et configure une infrastructure adaptee a votre projet : serveurs performants, CDN pour la distribution mondiale du contenu, certificats SSL pour la securite et sauvegardes automatiques pour la tranquillite.</p>
              <p>Pas besoin de gerer les aspects techniques : je m'occupe de la configuration, de la surveillance et des mises a jour de l'infrastructure.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Disponibilite', value: '99.9%' },
              { label: 'Temps de reponse', value: '<200ms' },
              { label: 'Sites heberges', value: '20+' },
              { label: 'Datacenters EU', value: '3' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Ce qui est <em class="text-point">inclus</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Serveurs haute performance', desc: "Infrastructure optimisee avec SSD NVMe, processeurs derniere generation et memoire suffisante pour garantir des temps de reponse inferieurs a 200ms." },
          { title: 'CDN mondial', desc: "Distribution du contenu statique via un reseau de serveurs repartis dans le monde entier. Vos pages se chargent rapidement, ou que soient vos visiteurs." },
          { title: 'Certificat SSL inclus', desc: "HTTPS active sur toutes les formules. Les donnees echangees entre votre site et vos visiteurs sont chiffrees. Bonus SEO aupres de Google." },
          { title: 'Sauvegardes automatiques', desc: "Sauvegardes regulieres de vos fichiers et bases de donnees. Restauration possible en quelques clics en cas de probleme ou de mauvaise manipulation." },
          { title: 'Monitoring uptime', desc: "Surveillance 24/7 de la disponibilite de votre site. Alerte en temps reel et intervention rapide en cas de panne ou de degradation des performances." },
          { title: 'Migration gratuite', desc: "Transfert de votre site existant vers la nouvelle infrastructure sans interruption de service. Configuration DNS, fichiers et bases de donnees inclus." },
        ].map(item => (
          <div class="border border-filet p-6">
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Tarifs -->
    <section id="tarifs" class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
          Nos <em class="text-point">formules</em>
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              name: 'Essentiel',
              price: 'A partir de 19',
              unit: '/mois',
              features: [
                '10 Go stockage SSD',
                'Certificat SSL inclus',
                'Sauvegarde hebdomadaire',
                'Monitoring disponibilite',
                'Support par email',
                '1 site heberge',
              ]
            },
            {
              name: 'Pro',
              price: 'A partir de 49',
              unit: '/mois',
              features: [
                '50 Go stockage SSD NVMe',
                'SSL + CDN inclus',
                'Sauvegarde quotidienne',
                'Monitoring avance',
                'Support email + telephone',
                'Jusqu\'a 5 sites heberges',
              ]
            },
            {
              name: 'Premium',
              price: 'A partir de 99',
              unit: '/mois',
              features: [
                'Stockage SSD illimite',
                'SSL + CDN + WAF inclus',
                'Sauvegarde quotidienne + externe',
                'Monitoring 24/7 + alertes',
                'Support prioritaire illimite',
                'Sites illimites + staging',
              ]
            },
          ].map(plan => (
            <div class="border border-filet p-8 flex flex-col">
              <h3 class="text-encre font-semibold text-xl mb-2">{plan.name}</h3>
              <div class="mb-6">
                <span class="text-3xl font-display font-bold text-point">{plan.price}</span>
                <span class="text-cartel text-sm"> euros{plan.unit}</span>
              </div>
              <ul class="space-y-3 text-cartel text-sm mb-8 flex-1">
                {plan.features.map(f => (
                  <li class="flex items-start gap-2">
                    <span class="text-point mt-0.5 shrink-0">-</span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/#contact" class="btn-primary text-center w-full">
                Choisir cette formule
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Questions <em class="text-point">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Ou sont situes les serveurs ?',
            a: 'Les serveurs sont heberges en France et en Europe, conformes au RGPD. Un CDN distribue le contenu au plus pres de vos visiteurs pour reduire les temps de chargement.'
          },
          {
            q: 'Le certificat SSL est-il inclus ?',
            a: 'Oui, un certificat SSL est inclus dans toutes les formules. Votre site est accessible en HTTPS, ce qui securise les echanges et ameliore votre positionnement Google.'
          },
          {
            q: 'Que se passe-t-il en cas de pic de trafic ?',
            a: 'Les formules Pro et Premium incluent une mise a l\'echelle automatique pour absorber les pics de trafic. La formule Essentielle dispose de ressources suffisantes pour la majorite des sites vitrines.'
          },
          {
            q: 'Puis-je migrer mon site existant vers votre hebergement ?',
            a: 'Oui, la migration est incluse dans toutes les formules. Je m\'occupe du transfert des fichiers, de la base de donnees et de la configuration DNS, sans interruption de service.'
          },
          {
            q: 'Quelle est la garantie de disponibilite ?',
            a: 'Je garantis un taux de disponibilite de 99.9% sur toutes les formules. Le monitoring permanent detecte les incidents en temps reel et permet une intervention rapide.'
          },
        ].map(item => (
          <details class="border border-filet p-6 group">
            <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-oeuvre border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Pret a passer a un hebergement <em class="text-point">fiable</em> ?
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Echangeons sur votre projet. Je vous recommande la formule la plus adaptee a vos besoins et votre budget.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
