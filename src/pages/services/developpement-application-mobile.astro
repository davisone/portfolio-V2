---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Développement application mobile à Rennes",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement application mobile",
      "description": "Développement d'applications mobiles iOS et Android à Rennes avec Flutter. Une seule codebase pour toutes les plateformes, livraison rapide, performances natives.",
      "url": "https://www.evandavison.fr/services/developpement-application-mobile"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Développement application mobile Rennes", "item": "https://www.evandavison.fr/services/developpement-application-mobile" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le coût de développement d'une application mobile ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le prix d'une application mobile varie selon la complexité : une app simple démarre autour de 2 000€, une application avec authentification, base de données et fonctionnalités avancées peut aller de 4 000€ à 10 000€. Un devis précis est établi après analyse de vos besoins." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi Flutter plutôt que React Native ou du natif ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Flutter permet de livrer une application iOS et Android à partir d'une seule codebase, avec des performances proches du natif. Le développement est plus rapide et moins coûteux que deux apps natives distinctes, tout en gardant une qualité visuelle très élevée." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour développer une application mobile ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une application simple est livrable en 4 à 6 semaines. Une app avec back-end, authentification et fonctionnalités métier prend généralement 8 à 16 semaines selon la portée du projet." }
        },
        {
          "@type": "Question",
          "name": "L'application sera-t-elle publiée sur l'App Store et Google Play ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je gère la publication sur les deux stores : préparation des assets (icônes, captures d'écran), configuration des comptes développeur, soumission et suivi de la validation. La publication est incluse dans le prix ou proposée en option selon le forfait." }
        },
        {
          "@type": "Question",
          "name": "Peut-on connecter l'application à une base de données ou un back-end existant ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je développe aussi bien le back-end (API REST, authentification, base de données) que le front-end mobile. Si vous avez déjà une API, je l'intègre directement dans l'application Flutter." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Développement application mobile Rennes | Evan Davison"
  description="Développement d'applications mobiles iOS et Android à Rennes avec Flutter. Une seule codebase, performances natives, livraison rapide. Devis gratuit."
  canonical="https://www.evandavison.fr/services/developpement-application-mobile/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Application mobile Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Application <em class="text-point">mobile</em><br/>iOS & Android
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Je développe des applications mobiles performantes avec Flutter : une seule codebase pour iPhone et Android. Idéal pour les startups et PME qui veulent aller vite sans sacrifier la qualité.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Parler de mon projet
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes projets
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Deux applis pour le prix <em class="text-point">d'une seule</em>
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Développer une app native iOS et une app Android séparément coûte cher et prend deux fois plus de temps. Flutter change la donne : une seule base de code, deux plateformes, performances proches du natif.</p>
              <p>Que vous ayez besoin d'une application de gestion interne, d'un outil client B2C, ou d'une app de fidélité : je conçois une solution adaptée à vos besoins et à votre budget.</p>
              <p>Basé à Rennes, je travaille en direct avec vous, sans intermédiaire.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Plateformes', value: 'iOS + Android' },
              { label: 'Technologie', value: 'Flutter' },
              { label: 'Délai moyen', value: '6-8 sem.' },
              { label: 'Publication stores', value: 'Incluse' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Le process <em class="text-point">de A à Z</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Cadrage', desc: 'Définition des fonctionnalités, user flows, wireframes. On aligne la vision avant d\'écrire une ligne de code.' },
          { step: '02', title: 'Design', desc: 'Maquettes UI adaptées aux guidelines iOS et Material Design. Interface intuitive et cohérente.' },
          { step: '03', title: 'Développement', desc: 'Flutter front-end + back-end API si nécessaire. Tests sur vrais appareils iOS et Android.' },
          { step: '04', title: 'Publication', desc: 'Soumission App Store et Google Play, suivi de validation, et accompagnement post-lancement.' },
        ].map(item => (
          <div class="border border-filet p-6">
            <div class="text-4xl font-display font-black text-filet/50 mb-3">{item.step}</div>
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Mes <em class="text-point">projets mobiles</em>
        </h2>
        <p class="text-cartel mb-8">Des applications concrètes développées avec Flutter.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Questions <em class="text-point">fréquentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Quel est le coût de développement d\'une application mobile ?',
            a: 'Une app simple démarre autour de 2 000€, une application avec authentification, base de données et fonctionnalités avancées peut aller de 4 000€ à 10 000€. Un devis précis est établi après analyse de vos besoins.'
          },
          {
            q: 'Pourquoi Flutter plutôt que React Native ou du natif ?',
            a: 'Flutter permet de livrer une app iOS et Android à partir d\'une seule codebase, avec des performances proches du natif. Le développement est plus rapide et moins coûteux que deux apps natives distinctes, tout en gardant une qualité visuelle très élevée.'
          },
          {
            q: 'Combien de temps faut-il pour développer une application mobile ?',
            a: 'Une application simple est livrable en 4 à 6 semaines. Une app avec back-end, authentification et fonctionnalités métier prend généralement 8 à 16 semaines.'
          },
          {
            q: 'L\'application sera-t-elle publiée sur l\'App Store et Google Play ?',
            a: 'Oui, je gère la publication sur les deux stores : assets, configuration des comptes développeur, soumission et suivi de la validation.'
          },
          {
            q: 'Peut-on connecter l\'application à un back-end existant ?',
            a: 'Oui, je développe aussi bien le back-end (API REST, authentification, base de données) que le front-end mobile. Si vous avez déjà une API, je l\'intègre directement.'
          },
        ].map(item => (
          <details class="border border-filet p-6 group">
            <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-point shrink-0">+</span>
            </summary>
            <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-oeuvre border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Votre app est à portée de main
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Dites-moi ce que vous voulez construire. Je vous aide à définir le périmètre et à lancer le projet.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
