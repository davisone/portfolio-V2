---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web à Bruz",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Bruz" },
      "serviceType": "Développement web",
      "description": "Création de sites web pour les professionnels de Bruz : commerces, services, entreprises du campus universitaire et écoles. Sites performants avec SEO local intégré.",
      "url": "https://www.evandavison.fr/services/creation-site-web-bruz"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Création site web Bruz", "item": "https://www.evandavison.fr/services/creation-site-web-bruz" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Créez-vous des sites pour les commerces de Bruz ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je conçois des sites web pour les commerces et services de Bruz : restaurants, salons, boutiques et prestataires. Un site bien référencé vous rend visible auprès des habitants et de la population étudiante." }
        },
        {
          "@type": "Question",
          "name": "La population étudiante de Bruz est-elle un atout pour mon site web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Le campus de Ker Lann et CentraleSupélec attirent des milliers d'étudiants qui consomment localement et cherchent tout sur leur téléphone. Un site mobile-first et bien référencé capte cette clientèle jeune et connectée." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous des sites pour les associations et écoles de Bruz ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, Bruz a un tissu associatif riche et plusieurs établissements d'enseignement supérieur. Je crée des sites adaptés : présentation des activités, inscriptions en ligne, agenda des événements." }
        },
        {
          "@type": "Question",
          "name": "Quel est le délai pour créer un site web à Bruz ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine est livré en 2 à 3 semaines, un site e-commerce en 4 à 6 semaines. Je m'adapte à vos contraintes et vous tenez informé tout au long du projet." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Création site web Bruz | Evan Davison · Développeur Web"
  description="Création de sites web à Bruz pour commerces, services et entreprises. Sites performants, design soigné et SEO local. Devis gratuit."
  canonical="https://www.evandavison.fr/services/creation-site-web-bruz/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Création site web Bruz</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Création <em class="text-point">site web</em><br/>à Bruz
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Campus de Ker Lann, CentraleSupelec, population jeune et dynamique : Bruz est bien plus qu'une commune periurbaine de Rennes. Avec ses milliers d'etudiants, ses ecoles d'ingenieurs et ses entreprises innovantes, votre site web doit parler a une audience connectee, exigeante et habituee aux standards du numerique.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Obtenir un devis gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Capter une clientele <em class="text-point">jeune et connectee</em>
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Bruz accueille le campus de Ker Lann : CentraleSupelec, ENS Rennes, ecoles de commerce : et une population etudiante qui represente un vivier de clients pour les commerces locaux. Ces jeunes actifs et etudiants cherchent tout sur leur telephone : restaurant pour le dejeuner, salle de sport, coiffeur, superette.</p>
              <p>Je cree des sites penses pour cette realite : mobile-first, temps de chargement ultra-rapide, referencement local sur "Bruz" et "Ker Lann". Votre site devient votre meilleur commercial aupres d'une clientele qui ne consulte pas les pages jaunes.</p>
              <p>Base pres de Rennes, je suis a quelques minutes de Bruz. Je connais la ville, son tissu commercial et les attentes specifiques d'une commune universitaire en pleine croissance.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Sites livrés', value: '20+' },
              { label: 'Délai moyen', value: '2-3 sem.' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'Satisfaction client', value: '100%' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Comment ça <em class="text-point">se passe</em> ?
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Echange', desc: "On discute de votre activite a Bruz, de votre clientele (etudiants, familles, entreprises) et de ce que vous attendez de votre site." },
          { step: '02', title: 'Maquette', desc: "Design moderne et sur mesure, adapte a votre image. Un site de restaurant n'a pas les memes codes qu'un site de formation." },
          { step: '03', title: 'Developpement', desc: "Code performant, mobile-first · indispensable avec une clientele etudiante. Optimisation SEO local integree des le depart." },
          { step: '04', title: 'Lancement', desc: "Mise en ligne, Google Business, referencement local et formation pour que vous puissiez gerer votre contenu en autonomie." },
        ].map(item => (
          <div class="border border-filet p-6">
            <div class="text-4xl font-display font-black text-filet/50 mb-3">{item.step}</div>
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Quelques <em class="text-point">realisations</em>
        </h2>
        <p class="text-cartel mb-8">Des projets realises pour des professionnels de la metropole rennaise et de toute la Bretagne.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Questions <em class="text-point">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Creez-vous des sites pour les commerces de Bruz ?',
            a: 'Oui, je concois des sites pour les commerces et services de Bruz : restaurants, salons, boutiques et prestataires. Un site bien reference vous rend visible aupres des habitants et de la population etudiante.'
          },
          {
            q: 'La population etudiante de Bruz est-elle un atout pour mon site ?',
            a: 'Absolument. Le campus de Ker Lann et CentraleSupelec attirent des milliers d\'etudiants qui consomment localement et cherchent tout sur leur telephone. Un site mobile-first capte cette clientele jeune et connectee.'
          },
          {
            q: 'Proposez-vous des sites pour les associations et ecoles de Bruz ?',
            a: 'Oui, Bruz a un tissu associatif riche et plusieurs etablissements d\'enseignement superieur. Je cree des sites adaptes : presentation des activites, inscriptions en ligne, agenda des evenements.'
          },
          {
            q: 'Quel est le delai pour creer un site a Bruz ?',
            a: 'Un site vitrine est livre en 2 a 3 semaines, un site e-commerce en 4 a 6 semaines. Je m\'adapte a vos contraintes et vous tiens informe tout au long du projet.'
          },
        ].map(item => (
          <details class="border border-filet p-6 group">
            <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-oeuvre border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Un projet web a Bruz ?
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Rencontrons-nous pres du campus ou en visio. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
