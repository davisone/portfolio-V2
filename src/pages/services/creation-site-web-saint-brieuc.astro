---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web à Saint-Brieuc",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Saint-Brieuc" },
      "serviceType": "Développement web",
      "description": "Développeur web freelance pour les entreprises de Saint-Brieuc et des Côtes-d'Armor. Sites vitrines, boutiques en ligne et applications web sur mesure.",
      "url": "https://www.evandavison.fr/services/creation-site-web-saint-brieuc"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Création site web Saint-Brieuc", "item": "https://www.evandavison.fr/services/creation-site-web-saint-brieuc" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi choisir un développeur freelance plutôt qu'une agence à Saint-Brieuc ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un freelance offre un interlocuteur unique, des tarifs sans surcoût de structure d'agence, et une réactivité supérieure. Vous travaillez directement avec le développeur qui code votre site, sans intermédiaire ni commercial." }
        },
        {
          "@type": "Question",
          "name": "Créez-vous des sites pour les artisans et commerçants des Côtes-d'Armor ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je travaille régulièrement avec des artisans, commerçants et professions libérales des Côtes-d'Armor. Un site vitrine professionnel vous démarque de la concurrence locale et vous rend trouvable sur Google par vos clients potentiels." }
        },
        {
          "@type": "Question",
          "name": "Pouvez-vous créer un site web pour une association à Saint-Brieuc ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je propose des sites adaptés aux budgets associatifs : présentation de l'association, agenda des événements, formulaire d'adhésion en ligne. Des solutions simples à gérer et économiques." }
        },
        {
          "@type": "Question",
          "name": "Le site sera-t-il adapté aux téléphones mobiles ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Tous mes sites sont conçus en mobile-first : l'expérience sur smartphone est la priorité, puis le design s'adapte aux tablettes et écrans larges. Plus de 60% du trafic web vient du mobile, c'est indispensable." }
        },
        {
          "@type": "Question",
          "name": "Quel est le tarif pour un site web à Saint-Brieuc ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine démarre à 800 euros, un e-commerce à partir de 1 500 euros. Je propose aussi des facilités de paiement pour les petites structures. Chaque devis est gratuit et détaillé." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Création site web Saint-Brieuc | Evan Davison — Développeur Web"
  description="Création de sites web à Saint-Brieuc et en Côtes-d'Armor. Sites vitrines, e-commerce et applications web pour artisans, commerces et PME. Devis gratuit."
  canonical="https://www.evandavison.fr/services/creation-site-web-saint-brieuc/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Création site web Saint-Brieuc</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Création <em class="text-accent">site web</em><br/>à Saint-Brieuc
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Prefecture des Cotes-d'Armor, Saint-Brieuc est le coeur economique d'un territoire ou artisans, commercants et PME font vivre le tissu local. Je cree des sites web sur mesure qui vous rendent visible aupres de vos clients — dans la baie de Saint-Brieuc, dans le Tregor ou sur tout le departement.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Obtenir un devis gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Les <em class="text-accent">Cotes-d'Armor</em> meritent du web de qualite
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Beaucoup d'entreprises des Cotes-d'Armor n'ont pas encore franchi le cap du numerique, ou se contentent d'un site vieillissant cree il y a des annees. Pendant ce temps, les clients cherchent sur Google — et trouvent vos concurrents.</p>
              <p>Je concois des sites modernes et performants pour les professionnels de Saint-Brieuc et du departement : artisans du batiment, commerces du centre-ville, professions liberales, prestataires de services. Chaque site est pense pour attirer des clients, pas juste pour "etre present en ligne".</p>
              <p>Base pres de Rennes, Saint-Brieuc est a une heure de route. Je me deplace pour les rendez-vous et travaille en visio pour le suivi courant. Vous avez un interlocuteur unique, disponible et reactif.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Sites livrés', value: '20+' },
              { label: 'Délai moyen', value: '2-4 sem.' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'Satisfaction client', value: '100%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Comment ça <em class="text-accent">se passe</em> ?
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Ecoute', desc: "On echange sur votre metier, votre clientele et vos objectifs. Je prends le temps de comprendre votre realite avant de proposer quoi que ce soit." },
          { step: '02', title: 'Proposition', desc: "Maquette personnalisee et devis detaille. Vous savez exactement ce que vous allez obtenir, pour quel budget et dans quel delai." },
          { step: '03', title: 'Fabrication', desc: "Developpement avec des technologies modernes. Vous suivez l'avancement et validez chaque etape importante." },
          { step: '04', title: 'Livraison', desc: "Mise en ligne, optimisation pour les recherches locales en Cotes-d'Armor, formation et support apres lancement." },
        ].map(item => (
          <div class="border border-border p-6">
            <div class="text-4xl font-serif font-black text-border/50 mb-3">{item.step}</div>
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Quelques <em class="text-accent">realisations</em>
        </h2>
        <p class="text-text-body mb-8">Des projets realises pour des professionnels des Cotes-d'Armor et de toute la Bretagne.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Pourquoi choisir un freelance plutot qu\'une agence a Saint-Brieuc ?',
            a: 'Un freelance offre un interlocuteur unique, des tarifs sans surcout de structure d\'agence, et une reactivite superieure. Vous travaillez directement avec le developpeur qui code votre site, sans intermediaire.'
          },
          {
            q: 'Creez-vous des sites pour les artisans et commercants des Cotes-d\'Armor ?',
            a: 'Oui, je travaille regulierement avec des artisans, commercants et professions liberales du departement. Un site vitrine professionnel vous demarque de la concurrence locale et vous rend trouvable sur Google.'
          },
          {
            q: 'Pouvez-vous creer un site web pour une association ?',
            a: 'Oui, je propose des sites adaptes aux budgets associatifs : presentation, agenda des evenements, formulaire d\'adhesion en ligne. Des solutions simples a gerer et economiques.'
          },
          {
            q: 'Le site sera-t-il adapte aux telephones mobiles ?',
            a: 'Tous mes sites sont concus en mobile-first : l\'experience sur smartphone est la priorite. Plus de 60% du trafic web vient du mobile, c\'est indispensable pour capter vos clients.'
          },
          {
            q: 'Quel est le tarif pour un site web a Saint-Brieuc ?',
            a: 'Un site vitrine demarre a 800 euros, un e-commerce a partir de 1 500 euros. Je propose aussi des facilites de paiement pour les petites structures. Chaque devis est gratuit et detaille.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Un projet web a Saint-Brieuc ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Echangeons sur votre besoin — a Saint-Brieuc ou en visio. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
