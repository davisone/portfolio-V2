---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web pour avocat à Rennes",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Création de sites web professionnels pour avocats et cabinets juridiques à Rennes : prise de rendez-vous, domaines de compétence, confidentialité et image de marque.",
      "url": "https://www.evandavison.fr/services/site-web-avocat-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web avocat Rennes", "item": "https://www.evandavison.fr/services/site-web-avocat-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Un site web d'avocat doit-il respecter des règles déontologiques ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui. Le Règlement Intérieur National de la profession d'avocat encadre la communication en ligne. Je connais ces contraintes et conçois votre site en totale conformité : pas de démarchage, mentions obligatoires, respect du secret professionnel." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer la prise de rendez-vous en ligne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, j'intègre un système de prise de rendez-vous sécurisé (Calendly, Cal.com ou solution sur mesure) permettant à vos clients de réserver un créneau de consultation directement depuis votre site." }
        },
        {
          "@type": "Question",
          "name": "Le site garantit-il la confidentialité des échanges ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Le site est en HTTPS obligatoire, les formulaires de contact sont sécurisés, et aucune donnée sensible n'est stockée sur le site. Conformité RGPD intégrale." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour créer un site de cabinet d'avocats ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine pour avocat est livré en 2 à 3 semaines. Pour un cabinet avec plusieurs associés et de nombreux domaines de compétence, comptez 3 à 5 semaines. Le planning est défini ensemble dès le départ." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web avocat Rennes | Evan Davison — Développeur Web"
  description="Création de site web pour avocat et cabinet juridique à Rennes. Design sobre, prise de RDV, domaines de compétence, conformité déontologique. Devis gratuit."
  canonical="https://www.evandavison.fr/services/site-web-avocat-rennes"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Site web avocat Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Un site pour <em class="text-accent">avocat</em> qui inspire<br/>confiance des le premier clic
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Design sobre et professionnel, prise de rendez-vous en ligne, presentation claire de vos domaines de competence — un site conforme a la deontologie qui attire les bons clients a Rennes.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Vos futurs clients comparent les <em class="text-accent">cabinets en ligne</em> avant de vous appeler
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Un justiciable qui cherche un avocat en droit de la famille ou en droit du travail a Rennes commence toujours par Google. Il compare les sites, lit les domaines de competence, et choisit le cabinet qui inspire le plus confiance en ligne.</p>
              <p>Un site d'avocat ne doit pas ressembler a n'importe quel site vitrine. Il doit vehiculer la rigueur, la confidentialite et le professionnalisme. Chaque element de design, chaque mot, chaque interaction doit renforcer votre credibilite.</p>
              <p>Je concois des sites pour avocats et cabinets juridiques en respectant les obligations deontologiques du RIN, tout en maximisant votre visibilite sur les recherches locales a Rennes et en Ille-et-Vilaine.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Cherchent un avocat en ligne', value: '75%' },
              { label: 'Comparent plusieurs cabinets', value: '68%' },
              { label: 'Veulent prendre RDV en ligne', value: '52%' },
              { label: 'Verifient les specialites', value: '89%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Les indispensables d'un site de <em class="text-accent">cabinet d'avocats</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Domaines de competence', desc: "Presentation structuree de vos specialisations : droit de la famille, droit du travail, droit des affaires. Chaque domaine avec sa page dediee pour le SEO." },
          { title: 'Prise de rendez-vous', desc: "Systeme de reservation en ligne securise. Vos clients reservent un creneau de consultation sans vous deranger pendant une audience." },
          { title: 'Conformite deontologique', desc: "Site concu dans le respect du RIN : pas de demarchage, mentions legales conformes, barreau d'appartenance, serment. Aucun ecart." },
          { title: 'Presentation de l\'equipe', desc: "Page dediee pour chaque avocat du cabinet : parcours, specialisations, barreau. Humaniser le cabinet pour rassurer le justiciable." },
          { title: 'Securite et confidentialite', desc: "HTTPS obligatoire, formulaires securises, aucune donnee sensible stockee. Conformite RGPD et respect du secret professionnel." },
          { title: 'Honoraires transparents', desc: "Section claire sur vos modes de facturation : consultation, forfait, aide juridictionnelle. La transparence rassure et filtre les demandes." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Des sites qui <em class="text-accent">incarnent votre rigueur</em>
        </h2>
        <p class="text-text-body mb-8">Decouvrez des projets au design sobre et professionnel.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Un site web d\'avocat doit-il respecter des regles deontologiques ?',
            a: 'Oui. Le Reglement Interieur National de la profession d\'avocat encadre la communication en ligne. Je connais ces contraintes et concois votre site en totale conformite : pas de demarchage, mentions obligatoires, respect du secret professionnel.'
          },
          {
            q: 'Peut-on integrer la prise de rendez-vous en ligne ?',
            a: 'Oui, j\'integre un systeme de prise de rendez-vous securise (Calendly, Cal.com ou solution sur mesure) permettant a vos clients de reserver un creneau de consultation directement depuis votre site.'
          },
          {
            q: 'Le site garantit-il la confidentialite des echanges ?',
            a: 'Absolument. Le site est en HTTPS obligatoire, les formulaires de contact sont securises, et aucune donnee sensible n\'est stockee sur le site. Conformite RGPD integrale.'
          },
          {
            q: 'Combien de temps pour creer un site de cabinet d\'avocats ?',
            a: 'Un site vitrine pour avocat est livre en 2 a 3 semaines. Pour un cabinet avec plusieurs associes et de nombreux domaines de competence, comptez 3 a 5 semaines. Le planning est defini ensemble des le depart.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Pret a renforcer la presence en ligne de votre cabinet ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre cabinet et de vos objectifs de visibilite. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
