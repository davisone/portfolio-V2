---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Developpement application mobile Flutter",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Developpement mobile cross-platform Flutter / Dart",
      "description": "Developpement d'applications mobiles cross-platform avec Flutter et Dart. iOS et Android depuis un seul codebase, performances natives, UI soignee.",
      "url": "https://www.evandavison.fr/services/developpement-flutter-dart"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Developpement Flutter / Dart", "item": "https://www.evandavison.fr/services/developpement-flutter-dart" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi choisir Flutter plutot que le developpement natif ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Flutter permet de developper une seule fois pour iOS et Android, reduisant les couts et delais de moitie par rapport au developpement natif separe. Les performances restent proches du natif grace a la compilation AOT en code machine, et l'interface est pixel-perfect sur les deux plateformes." }
        },
        {
          "@type": "Question",
          "name": "Une application Flutter est-elle aussi rapide qu'une application native ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, Flutter compile directement en code machine ARM (pas d'interpreteur ni de bridge). Le moteur de rendu Skia/Impeller assure des animations fluides a 60 fps. Pour la grande majorite des applications metier, les performances sont indiscernables du natif." }
        },
        {
          "@type": "Question",
          "name": "Combien coute le developpement d'une application mobile Flutter ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une application mobile simple (quelques ecrans, API REST) demarre autour de 3 000 euros. Une application complexe avec authentification, notifications push, geolocalisation et back-end dedié peut aller de 5 000 a 15 000 euros selon les fonctionnalites." }
        },
        {
          "@type": "Question",
          "name": "Flutter fonctionne-t-il aussi pour le web et le desktop ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, Flutter supporte le web, Windows, macOS et Linux en plus d'iOS et Android. Un meme codebase peut cibler toutes ces plateformes, bien que le web reste plus adapte a React/Next.js pour le SEO. Flutter web convient bien aux applications internes ou aux PWA." }
        },
        {
          "@type": "Question",
          "name": "Quel est le delai pour developper une application Flutter ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un MVP (produit minimum viable) est generalement livre en 4 a 8 semaines. Une application complete avec toutes les fonctionnalites prend 8 a 16 semaines. Le codebase unique pour iOS et Android accelere considerablement le developpement par rapport au natif." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Developpeur Flutter et Dart Rennes | Evan Davison"
  description="Developpeur Flutter freelance a Rennes. Applications mobiles cross-platform iOS et Android, performances natives, un seul codebase Dart. Devis gratuit."
  canonical="https://www.evandavison.fr/services/developpement-flutter-dart/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Developpement Flutter / Dart</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Developpeur <em class="text-point">Flutter</em><br/>applications mobiles
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Vous avez besoin d'une application mobile pour iOS et Android ? Je developpe des apps cross-platform avec Flutter et Dart : un seul codebase, des performances natives, un budget maitrise.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Discuter de votre application
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes realisations
          </a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Une app, <em class="text-point">deux plateformes</em>, zero compromis
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Developper deux applications natives separees pour iOS et Android, c'est doubler le budget, les delais et la maintenance. Et les solutions hybrides classiques sacrifient souvent les performances.</p>
              <p>Flutter change la donne : un seul codebase Dart compile en code machine natif. Le moteur de rendu Impeller garantit des animations fluides a 60 fps. L'interface est pixel-perfect sur les deux plateformes.</p>
              <p>Je concois des applications mobiles pensees pour vos utilisateurs : navigation intuitive, chargement instantane, experience native sur chaque appareil.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Plateformes ciblees', value: 'iOS + Android' },
              { label: 'Codebase', value: '1 seul' },
              { label: 'Animations', value: '60 fps' },
              { label: 'Compilation', value: 'AOT natif' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-2xl sm:text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Cas d'usage -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Cas d'usage <em class="text-point">concrets</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Application metier', desc: "Gestion de stocks, suivi de commandes, CRM mobile. Vos processus internes accessibles partout, meme hors connexion." },
          { title: 'Application e-commerce', desc: "Catalogue produits, panier, paiement securise, notifications push pour les promotions. Experience d'achat native et fluide." },
          { title: 'Application de services', desc: "Prise de rendez-vous, geolocalisation, messagerie integree. Connectez vos clients a vos services en temps reel." },
          { title: 'MVP / Startup', desc: "Prototype fonctionnel rapide pour valider votre idee. Un seul developpement pour tester sur les deux plateformes." },
          { title: 'Application IoT', desc: "Controle d'appareils connectes via Bluetooth ou WiFi. Tableaux de bord temps reel, historique de donnees." },
          { title: 'Application sociale', desc: "Profils utilisateurs, fil d'actualite, messagerie, partage de contenu. Architecture scalable des le depart." },
        ].map(item => (
          <div class="border border-filet p-6">
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
          Du concept au <em class="text-point">store</em>
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { step: '01', title: 'Specification', desc: "Definition des fonctionnalites, wireframes, choix techniques. On clarifie le scope avant de coder." },
            { step: '02', title: 'Design UI', desc: "Maquettes haute fidelite respectant les guidelines Material Design et Human Interface." },
            { step: '03', title: 'Developpement', desc: "Code Flutter/Dart propre et teste. Integration API, authentification, stockage local." },
            { step: '04', title: 'Publication', desc: "Tests sur appareils reels, soumission App Store et Google Play, suivi post-lancement." },
          ].map(item => (
            <div class="border border-filet p-6">
              <div class="text-4xl font-display font-black text-filet/50 mb-3">{item.step}</div>
              <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Realisations liees -->
    <section class="section-container py-16 sm:py-24 text-center">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
        Applications <em class="text-point">Flutter</em> realisees
      </h2>
      <p class="text-cartel mb-8">Des applications mobiles concretes deployees sur les stores.</p>
      <a href="/#realisations" class="btn-primary">
        Voir toutes mes realisations
      </a>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
          Questions <em class="text-point">frequentes</em>
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {[
            {
              q: 'Pourquoi choisir Flutter plutot que le developpement natif ?',
              a: "Flutter permet de developper une seule fois pour iOS et Android, reduisant les couts et delais de moitie. Les performances restent proches du natif grace a la compilation AOT en code machine. L'interface est pixel-perfect sur les deux plateformes."
            },
            {
              q: "Une application Flutter est-elle aussi rapide qu'une app native ?",
              a: "Oui, Flutter compile directement en code machine ARM sans interpreteur ni bridge. Le moteur de rendu Impeller assure des animations fluides a 60 fps. Pour la grande majorite des applications metier, les performances sont indiscernables du natif."
            },
            {
              q: "Combien coute le developpement d'une application mobile Flutter ?",
              a: "Une application simple demarre autour de 3 000 euros. Une application complexe avec authentification, notifications push, geolocalisation et back-end dedie peut aller de 5 000 a 15 000 euros selon les fonctionnalites."
            },
            {
              q: 'Flutter fonctionne-t-il aussi pour le web et le desktop ?',
              a: "Oui, Flutter supporte le web, Windows, macOS et Linux en plus d'iOS et Android. Un meme codebase peut cibler toutes ces plateformes. Flutter web convient bien aux applications internes ou aux PWA."
            },
            {
              q: "Quel est le delai pour developper une application Flutter ?",
              a: "Un MVP est generalement livre en 4 a 8 semaines. Une application complete prend 8 a 16 semaines. Le codebase unique pour iOS et Android accelere considerablement le developpement par rapport au natif."
            },
          ].map(item => (
            <details class="border border-filet p-6 group">
              <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
                {item.q}
                <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Une idee d'application mobile ?
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Discutons de votre projet. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
