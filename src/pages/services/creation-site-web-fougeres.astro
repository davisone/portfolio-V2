---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web à Fougères",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Fougères" },
      "serviceType": "Développement web",
      "description": "Création de sites web pour les professionnels de Fougères : industries, commerces, artisans et acteurs du tourisme. Sites modernes optimisés pour le référencement local.",
      "url": "https://www.evandavison.fr/services/creation-site-web-fougeres"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Création site web Fougères", "item": "https://www.evandavison.fr/services/creation-site-web-fougeres" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Créez-vous des sites pour les entreprises industrielles de Fougères ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je réalise des sites professionnels pour les entreprises industrielles fougeraises : présentation de vos capacités de production, catalogue produits, espace recrutement et formulaire de contact B2B. Le site renforce votre crédibilité auprès des donneurs d'ordre." }
        },
        {
          "@type": "Question",
          "name": "Fougères est-elle en reconversion numérique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Fougères diversifie son économie au-delà de l'industrie traditionnelle. Le numérique joue un rôle clé dans cette transition. Un site web performant est un levier essentiel pour les entreprises qui se modernisent et cherchent de nouveaux marchés." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous des sites pour les acteurs du tourisme à Fougères ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, le château de Fougères est l'un des plus grands châteaux forts d'Europe et attire de nombreux visiteurs. Je crée des sites pour les hébergements, restaurants et commerces qui profitent de cette attractivité touristique." }
        },
        {
          "@type": "Question",
          "name": "Quel est le délai pour créer un site web à Fougères ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine est livré en 2 à 3 semaines, un site e-commerce en 4 à 6 semaines. Je m'adapte à vos contraintes de planning et vous tiens informé à chaque étape du projet." }
        },
        {
          "@type": "Question",
          "name": "Vous déplacez-vous à Fougères ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, basé près de Rennes, Fougères est à environ 50 minutes. Je me déplace volontiers pour un premier rendez-vous ou des points d'avancement. Le reste se fait facilement en visio." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Création site web Fougères | Evan Davison — Développeur Web"
  description="Création de sites web à Fougères pour industries, commerces et tourisme. Sites performants, design sur mesure et SEO local. Devis gratuit."
  canonical="https://www.evandavison.fr/services/creation-site-web-fougeres/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-cartel">
        <li><a href="/" class="hover:text-encre transition-colors">Accueil</a></li>
        <li class="text-filet">/</li>
        <li><a href="/#services" class="hover:text-encre transition-colors">Services</a></li>
        <li class="text-filet">/</li>
        <li class="text-encre">Création site web Fougères</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-encre mb-6 leading-tight">
          Création <em class="text-point">site web</em><br/>à Fougères
        </h1>
        <p class="text-xl text-cartel mb-8 leading-relaxed">
          Plus grand chateau fort d'Europe, heritage industriel de la chaussure et de l'agroalimentaire, reconversion vers le numerique — Fougeres se reinvente. Votre presence en ligne doit accompagner cette transformation, que vous soyez industriel historique, commercant du centre-ville ou acteur du tourisme patrimonial.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Obtenir un devis gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-6">
              Accompagner la <em class="text-point">reconversion numerique</em> de Fougeres
            </h2>
            <div class="space-y-4 text-cartel">
              <p>Fougeres a longtemps ete connue pour son industrie de la chaussure et son tissu agroalimentaire. Aujourd'hui, la ville diversifie son economie et le numerique devient un levier essentiel. Pourtant, beaucoup d'entreprises fougeraises n'ont pas encore de site web — ou possedent un site obsolete qui ne genere aucun contact.</p>
              <p>Je cree des sites web qui repondent aux vrais besoins des professionnels de Fougeres : vitrine credible pour les industriels en quete de nouveaux marches, boutique en ligne pour les commercants du centre-ville, site touristique pour capitaliser sur l'attractivite du chateau et du patrimoine medieval.</p>
              <p>Base pres de Rennes, je suis a 50 minutes de Fougeres. Je connais le bassin d'emploi fougerais et ses enjeux de modernisation.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Sites livrés', value: '20+' },
              { label: 'Délai moyen', value: '2-3 sem.' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'Satisfaction client', value: '100%' },
            ].map(stat => (
              <div class="border border-filet p-6 text-center">
                <div class="text-3xl font-display font-bold text-point mb-1">{stat.value}</div>
                <div class="text-cartel text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Comment ça <em class="text-point">se passe</em> ?
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Diagnostic', desc: "Analyse de votre activite, de votre positionnement a Fougeres et de vos objectifs : modernisation d'image, prospection, vente en ligne." },
          { step: '02', title: 'Maquette', desc: "Design sur mesure adapte a votre secteur. Un site industriel n'a pas les memes codes qu'un site touristique — chaque projet a son identite." },
          { step: '03', title: 'Developpement', desc: "Code performant, responsive et optimise pour le referencement local. Vous suivez l'avancement a chaque etape." },
          { step: '04', title: 'Lancement', desc: "Mise en ligne, configuration SEO local, fiche Google Business et formation a l'autonomie sur votre site." },
        ].map(item => (
          <div class="border border-filet p-6">
            <div class="text-4xl font-display font-black text-filet/50 mb-3">{item.step}</div>
            <h3 class="text-encre font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-cartel text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-oeuvre border-t border-b border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Quelques <em class="text-point">realisations</em>
        </h2>
        <p class="text-cartel mb-8">Des projets realises pour des professionnels du Pays de Fougeres et de toute la Bretagne.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-12 text-center">
        Questions <em class="text-point">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Creez-vous des sites pour les entreprises industrielles de Fougeres ?',
            a: 'Oui, je realise des sites professionnels pour les entreprises industrielles fougeraises : presentation de vos capacites de production, catalogue produits, espace recrutement et formulaire de contact B2B.'
          },
          {
            q: 'Fougeres est-elle en reconversion numerique ?',
            a: 'Fougeres diversifie son economie au-dela de l\'industrie traditionnelle. Le numerique joue un role cle dans cette transition. Un site web performant est un levier essentiel pour les entreprises qui se modernisent.'
          },
          {
            q: 'Proposez-vous des sites pour le tourisme a Fougeres ?',
            a: 'Oui, le chateau de Fougeres attire de nombreux visiteurs. Je cree des sites pour les hebergements, restaurants et commerces qui profitent de cette attractivite touristique, avec reservation en ligne et SEO local.'
          },
          {
            q: 'Quel est le delai pour creer un site a Fougeres ?',
            a: 'Un site vitrine est livre en 2 a 3 semaines, un site e-commerce en 4 a 6 semaines. Je m\'adapte a vos contraintes de planning et vous tiens informe a chaque etape.'
          },
          {
            q: 'Vous deplacez-vous a Fougeres ?',
            a: 'Oui, base pres de Rennes, Fougeres est a environ 50 minutes. Je me deplace pour les rendez-vous en personne et le reste se fait en visio.'
          },
        ].map(item => (
          <details class="border border-filet p-6 group">
            <summary class="text-encre font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-point shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-cartel mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-oeuvre border-t border-filet">
      <div class="section-container text-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-encre mb-4">
          Un projet web a Fougeres ?
        </h2>
        <p class="text-cartel mb-8 max-w-xl mx-auto">
          Rencontrons-nous a l'ombre du chateau ou en visio. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
