---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web à Nantes",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Nantes" },
      "serviceType": "Développement web",
      "description": "Développeur web freelance intervenant à Nantes : création de sites vitrines, applications web et boutiques en ligne pour les entreprises nantaises.",
      "url": "https://www.evandavison.fr/services/creation-site-web-nantes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Création site web Nantes", "item": "https://www.evandavison.fr/services/creation-site-web-nantes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Intervenez-vous directement à Nantes pour la création de sites web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je me déplace à Nantes pour les rendez-vous clients. Basé près de Rennes, Nantes est à moins d'1h30 de route. Les échanges se font aussi en visioconférence selon vos préférences." }
        },
        {
          "@type": "Question",
          "name": "Quel type de site web convient à une startup nantaise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pour une startup, je recommande une application web sur mesure avec Next.js ou Astro : rapide à itérer, performante et évolutive. Le MVP est livré en 3 à 5 semaines pour valider votre marché rapidement." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un site web professionnel à Nantes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine démarre à partir de 800 euros, une boutique en ligne à partir de 1 500 euros. Le tarif dépend des fonctionnalités, du design et du volume de pages. Devis gratuit sous 48h." }
        },
        {
          "@type": "Question",
          "name": "Pouvez-vous refondre un site existant pour une entreprise nantaise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Je réalise des refontes complètes : nouveau design, migration des contenus, amélioration des performances et du référencement. L'objectif est de moderniser votre image tout en conservant votre positionnement SEO." }
        },
        {
          "@type": "Question",
          "name": "Le site sera-t-il optimisé pour le référencement local à Nantes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, le SEO local est intégré dès la conception : balises géographiques, données structurées LocalBusiness, optimisation Google Business Profile et création de contenu ciblé sur Nantes et sa métropole." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Création site web Nantes | Evan Davison — Développeur Web"
  description="Développeur web freelance à Nantes : sites vitrines, applications web et e-commerce sur mesure. Solutions performantes, SEO intégré. Devis gratuit sous 48h."
  canonical="https://www.evandavison.fr/services/creation-site-web-nantes"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Création site web Nantes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Création <em class="text-accent">site web</em><br/>à Nantes
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Nantes est l'un des ecosystemes tech les plus dynamiques de l'Ouest. Que vous lanciez une startup sur l'ile de Nantes ou que vous dirigiez une PME dans le quartier de la creation, je developpe des sites web tailles pour vos ambitions — pas des templates recycles.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Obtenir un devis gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Votre vitrine digitale sur le <em class="text-accent">marche nantais</em>
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Nantes attire chaque annee des milliers d'entrepreneurs et de porteurs de projets. Dans cet environnement competitif, un site web generique ne suffit plus : il faut se demarquer avec une presence en ligne qui reflete la qualite de votre offre.</p>
              <p>Je concois des sites sur mesure pour les entreprises nantaises : design unique, code performant, et referencement naturel pense des le depart. Que vous soyez installe a Euronantes, au Hangar a Bananes ou dans le centre-ville, votre site doit parler a vos clients locaux.</p>
              <p>Basé pres de Rennes, j'interviens regulierement a Nantes — en presentiel ou en visio. La proximite geographique permet des echanges fluides et un suivi de projet reactif.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Sites livrés', value: '20+' },
              { label: 'Délai moyen', value: '3 sem.' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'Satisfaction client', value: '100%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Comment ça <em class="text-accent">se passe</em> ?
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Rencontre', desc: "On se retrouve a Nantes ou en visio pour comprendre votre activite, vos objectifs et votre marche cible. Sans engagement." },
          { step: '02', title: 'Strategie', desc: "Maquette sur mesure, choix des technologies adaptees a votre secteur, et architecture pensee pour le referencement local nantais." },
          { step: '03', title: 'Realisation', desc: "Developpement iteratif avec des points reguliers. Vous voyez votre site prendre forme et pouvez ajuster en cours de route." },
          { step: '04', title: 'Lancement', desc: "Mise en ligne, configuration du SEO local, formation a la gestion du contenu et accompagnement post-livraison." },
        ].map(item => (
          <div class="border border-border p-6">
            <div class="text-4xl font-serif font-black text-border/50 mb-3">{item.step}</div>
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Quelques <em class="text-accent">realisations</em>
        </h2>
        <p class="text-text-body mb-8">Des projets concrets pour des clients de Nantes, Rennes et toute la Bretagne.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Intervenez-vous directement a Nantes ?',
            a: 'Oui, je me deplace regulierement a Nantes pour les rendez-vous clients. Base pres de Rennes, le trajet est court. Les echanges courants se font aussi en visio pour plus de souplesse.'
          },
          {
            q: 'Quel type de site convient a une startup nantaise ?',
            a: 'Pour une startup, je recommande un MVP rapide avec Next.js ou Astro : performant, evolutif et livre en 3 a 5 semaines. L\'objectif est de valider votre marche avant d\'investir davantage.'
          },
          {
            q: 'Combien coute un site web professionnel a Nantes ?',
            a: 'Un site vitrine demarre a 800 euros, une boutique en ligne a partir de 1 500 euros. Le tarif depend des fonctionnalites et du volume de pages. Devis gratuit sous 48h.'
          },
          {
            q: 'Pouvez-vous refondre un site existant ?',
            a: 'Oui, je realise des refontes completes : nouveau design, migration des contenus, amelioration des performances et du SEO. Votre positionnement Google est preserve pendant la transition.'
          },
          {
            q: 'Le site sera-t-il optimise pour le referencement local a Nantes ?',
            a: 'Absolument. Le SEO local est integre des la conception : balises geographiques, donnees structurees, optimisation Google Business Profile et contenu cible sur la metropole nantaise.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Un projet web a Nantes ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Parlons de votre besoin autour d'un cafe a Nantes ou en visio. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
