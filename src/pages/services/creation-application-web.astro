---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Developpement application web sur mesure",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Developpement d'applications web et SaaS",
      "description": "Developpement d'applications web sur mesure a Rennes. Applications SaaS, tableaux de bord, outils metier. Architecture scalable, technologies modernes, UX soignee.",
      "url": "https://www.evandavison.fr/services/creation-application-web"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Application web", "item": "https://www.evandavison.fr/services/creation-application-web" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la difference entre un site web et une application web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site web presente de l'information (site vitrine, blog). Une application web permet aux utilisateurs d'interagir : creer un compte, gerer des donnees, effectuer des actions. Exemples : tableau de bord, outil de gestion, plateforme SaaS, espace client." }
        },
        {
          "@type": "Question",
          "name": "Combien coute le developpement d'une application web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le tarif depend de la complexite : un outil metier simple avec authentification demarre autour de 3 000 euros. Une application SaaS complete avec paiements, API et multi-tenant peut aller de 8 000 a 25 000 euros. Un MVP permet de valider le concept avant d'investir davantage." }
        },
        {
          "@type": "Question",
          "name": "Quelles technologies utilisez-vous pour les applications web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le front-end est developpe en React avec Next.js et TypeScript. Le back-end utilise Node.js avec des bases de donnees PostgreSQL ou MongoDB selon le besoin. L'infrastructure est deployee sur Vercel ou AWS. Chaque choix technique est adapte au projet." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous le developpement d'un MVP ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, c'est meme recommande. Un MVP (produit minimum viable) permet de valider votre idee avec un budget maitrise, de recueillir les retours des premiers utilisateurs et d'iterer rapidement. Mieux vaut un produit simple qui fonctionne qu'une usine a gaz jamais livree." }
        },
        {
          "@type": "Question",
          "name": "Comment gerez-vous la securite des donnees utilisateurs ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La securite est integree des la conception : authentification robuste (OAuth, JWT), chiffrement des donnees sensibles, protection contre les injections SQL et XSS, HTTPS obligatoire, gestion des roles et permissions. Les bonnes pratiques OWASP sont appliquees systematiquement." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Developpement application web sur mesure | Evan Davison"
  description="Developpement d'applications web et SaaS sur mesure a Rennes. Tableaux de bord, outils metier, plateformes en ligne. React, Next.js, Node.js. Devis gratuit."
  canonical="https://www.evandavison.fr/services/creation-application-web/"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Application web sur mesure</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          <em class="text-accent">Application web</em><br/>sur mesure
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Vous avez besoin d'un outil metier, d'un tableau de bord ou d'une plateforme SaaS ? Je developpe des applications web sur mesure — pensees pour vos utilisateurs, construites pour durer.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Discuter de votre projet
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes realisations
          </a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Votre metier merite un <em class="text-accent">outil dedie</em>
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Vous gerez votre activite avec des fichiers Excel, des outils generiques empiles les uns sur les autres, ou un logiciel qui ne correspond plus a vos besoins ? Chaque jour perdu en contournements, c'est de l'efficacite en moins.</p>
              <p>Une application web sur mesure s'adapte a vos processus — pas l'inverse. Elle centralise vos donnees, automatise les taches repetitives et offre a vos equipes (ou vos clients) une interface claire et intuitive.</p>
              <p>Du MVP pour valider une idee a la plateforme SaaS complete, je concois des applications qui repondent precisement a votre besoin metier.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Applications livrees', value: '10+' },
              { label: 'Disponibilite moyenne', value: '99.9%' },
              { label: 'Stack', value: 'Fullstack' },
              { label: 'Approche', value: 'MVP first' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-2xl sm:text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Types d'applications -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Types d'applications <em class="text-accent">que je developpe</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Plateforme SaaS', desc: "Application multi-tenant avec abonnements, gestion des utilisateurs, API. Architecture pensee pour scaler avec votre croissance." },
          { title: 'Tableau de bord', desc: "Visualisation de donnees en temps reel, graphiques interactifs, exports. Vos KPI accessibles en un coup d'oeil." },
          { title: 'Outil metier', desc: "CRM, ERP leger, gestion de projets, suivi de production. Un outil qui colle a vos processus au lieu de les contraindre." },
          { title: 'Espace client', desc: "Portail securise pour vos clients : suivi de commandes, documents, factures, messagerie. Professionnel et autonome." },
          { title: 'Marketplace', desc: "Plateforme de mise en relation, catalogue, systeme de reservation ou d'achat. Gestion des vendeurs et des acheteurs." },
          { title: 'API et back-end', desc: "API REST ou GraphQL pour connecter vos applications. Authentification, base de donnees, webhooks, integrations tierces." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
          De l'idee au <em class="text-accent">produit</em>
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { step: '01', title: 'Cadrage', desc: "Definition du besoin, des utilisateurs cibles et du scope fonctionnel. On identifie le MVP — ce qui doit etre livre en premier." },
            { step: '02', title: 'Architecture', desc: "Choix de la stack technique, modelisation de la base de donnees, design des API. Structure pensee pour evoluer." },
            { step: '03', title: 'Sprints', desc: "Developpement iteratif en cycles courts. Livraisons regulieres, demos, ajustements. Vous voyez le produit avancer chaque semaine." },
            { step: '04', title: 'Deploiement', desc: "Mise en production, monitoring, documentation technique. Formation de votre equipe et accompagnement post-lancement." },
          ].map(item => (
            <div class="border border-border p-6">
              <div class="text-4xl font-serif font-black text-border/50 mb-3">{item.step}</div>
              <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stack technique -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Stack <em class="text-accent">technique</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Front-end', desc: "React, Next.js, TypeScript, Tailwind CSS" },
          { title: 'Back-end', desc: "Node.js, API REST/GraphQL, Prisma ORM" },
          { title: 'Base de donnees', desc: "PostgreSQL, MongoDB, Firebase, Redis" },
          { title: 'Infrastructure', desc: "Vercel, AWS, Docker, CI/CD GitHub Actions" },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations liees -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Applications web <em class="text-accent">realisees</em>
        </h2>
        <p class="text-text-body mb-8">Des applications concretes livrees et utilisees au quotidien.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes realisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: "Quelle est la difference entre un site web et une application web ?",
            a: "Un site web presente de l'information (site vitrine, blog). Une application web permet aux utilisateurs d'interagir : creer un compte, gerer des donnees, effectuer des actions. Exemples : tableau de bord, outil de gestion, plateforme SaaS, espace client."
          },
          {
            q: "Combien coute le developpement d'une application web ?",
            a: "Le tarif depend de la complexite : un outil metier simple demarre autour de 3 000 euros. Une application SaaS complete avec paiements, API et multi-tenant peut aller de 8 000 a 25 000 euros. Un MVP permet de valider le concept avant d'investir davantage."
          },
          {
            q: 'Quelles technologies utilisez-vous pour les applications web ?',
            a: "Front-end en React avec Next.js et TypeScript. Back-end en Node.js avec PostgreSQL ou MongoDB. Infrastructure sur Vercel ou AWS. Chaque choix technique est adapte au projet, pas impose par habitude."
          },
          {
            q: 'Proposez-vous le developpement d\'un MVP ?',
            a: "Oui, c'est meme recommande. Un MVP permet de valider votre idee avec un budget maitrise, de recueillir les retours utilisateurs et d'iterer rapidement. Mieux vaut un produit simple qui fonctionne qu'une usine a gaz jamais livree."
          },
          {
            q: 'Comment gerez-vous la securite des donnees utilisateurs ?',
            a: "La securite est integree des la conception : authentification robuste (OAuth, JWT), chiffrement des donnees sensibles, protection contre les injections SQL et XSS, HTTPS obligatoire, gestion des roles et permissions. Les bonnes pratiques OWASP sont appliquees."
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Une application web en tete ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre projet. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
