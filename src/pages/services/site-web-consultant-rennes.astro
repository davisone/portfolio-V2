---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web pour consultant à Rennes",
      "provider": { "@id": "https://evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Création de sites web sur mesure pour consultants et indépendants à Rennes : portfolio de missions, prise de contact, blog expertise et optimisation SEO.",
      "url": "https://evandavison.fr/services/site-web-consultant-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web consultant Rennes", "item": "https://evandavison.fr/services/site-web-consultant-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment un site web peut-il aider un consultant à trouver des clients ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site web positionne votre expertise sur Google, crédibilise votre profil auprès des prospects et génère des demandes de contact qualifiées. C'est votre vitrine permanente, accessible 24h/24, qui travaille pour vous même quand vous êtes en mission." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer un blog pour partager son expertise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Un blog est essentiel pour un consultant : il améliore votre référencement, démontre votre expertise et attire des prospects via des articles de fond sur vos domaines de compétence." }
        },
        {
          "@type": "Question",
          "name": "Le site peut-il présenter des études de cas et témoignages clients ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je crée des pages dédiées aux études de cas avec contexte, problématique, solution apportée et résultats chiffrés. Les témoignages clients sont mis en valeur pour renforcer la crédibilité." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer un système de prise de rendez-vous pour les appels découverte ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, j'intègre Calendly, Cal.com ou un formulaire sur mesure pour que vos prospects réservent un créneau d'appel découverte directement depuis votre site, sans échange de mails." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un site web pour un consultant à Rennes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine pour consultant avec blog et prise de rendez-vous démarre autour de 700 euros. Le prix varie selon les fonctionnalités souhaitées (espace client, formations en ligne, etc.). Devis gratuit sur demande." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web consultant Rennes | Evan Davison — Développeur Web"
  description="Création de site web pour consultant à Rennes : portfolio, blog expertise, prise de RDV, SEO. Un site qui génère des leads qualifiés. Devis gratuit."
  canonical="https://evandavison.fr/services/site-web-consultant-rennes"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Site web consultant Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Votre <em class="text-accent">expertise</em> merite<br/>une vitrine a la hauteur
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Portfolio de missions, blog expertise, prise de rendez-vous — un site web concu pour credibiliser votre activite de consultant et generer des leads qualifies a Rennes et au-dela.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Vos prospects vous recherchent sur <em class="text-accent">Google</em> avant de vous contacter
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Selon une etude BPI France, 85% des decideurs B2B recherchent un prestataire en ligne avant de le contacter. Un profil LinkedIn seul ne suffit plus : sans site web professionnel, vous passez a cote de prospects qui comparent et verifient avant de decrocher leur telephone.</p>
              <p>Un site de consultant performant, c'est une presentation claire de votre offre, des etudes de cas qui demontrent vos resultats, un blog qui positionne votre expertise sur les moteurs de recherche, et un parcours de prise de contact fluide.</p>
              <p>Je concois des sites qui transforment vos visiteurs en prospects : design professionnel qui inspire confiance, contenu structure pour le SEO, et appels a l'action strategiquement places pour maximiser les prises de contact.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Decideurs cherchent en ligne', value: '85%' },
              { label: 'Verifient le site avant contact', value: '75%' },
              { label: 'Leads via le site vs bouche-a-oreille', value: '+40%' },
              { label: 'Lisent le blog avant d\'acheter', value: '60%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Ce que votre site de <em class="text-accent">consultant</em> inclut
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Page offre de services', desc: "Presentation structuree de vos prestations avec methodologie, delivrables et benefices concrets. Chaque offre est detaillee pour rassurer vos prospects." },
          { title: 'Etudes de cas et resultats', desc: "Pages dediees avec contexte client, problematique, solution apportee et resultats chiffres. La preuve concrete de votre valeur ajoutee." },
          { title: 'Blog expertise', desc: "Espace pour publier des articles de fond, analyses sectorielles et retours d'experience. Ameliore le SEO et positionne votre autorite dans votre domaine." },
          { title: 'Prise de rendez-vous en ligne', desc: "Integration Calendly, Cal.com ou formulaire sur mesure. Vos prospects reservent un appel decouverte en quelques clics sans echange de mails." },
          { title: 'Temoignages et references', desc: "Section dediee aux temoignages clients et logos des entreprises accompagnees. La preuve sociale qui fait la difference face a la concurrence." },
          { title: 'Ressources telechargables', desc: "Livres blancs, guides et check-lists a telecharger en echange d'un email. Un levier de generation de leads pour alimenter votre prospection." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Des sites qui generent des <em class="text-accent">opportunites</em>
        </h2>
        <p class="text-text-body mb-8">Decouvrez des projets realises pour des consultants et independants.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Comment un site web peut-il aider un consultant a trouver des clients ?',
            a: 'Un site web positionne votre expertise sur Google, credibilise votre profil aupres des prospects et genere des demandes de contact qualifiees. C\'est votre vitrine permanente, accessible 24h/24, qui travaille pour vous meme quand vous etes en mission.'
          },
          {
            q: 'Peut-on integrer un blog pour partager son expertise ?',
            a: 'Absolument. Un blog est essentiel pour un consultant : il ameliore votre referencement, demontre votre expertise et attire des prospects via des articles de fond sur vos domaines de competence.'
          },
          {
            q: 'Le site peut-il presenter des etudes de cas et temoignages clients ?',
            a: 'Oui, je cree des pages dediees aux etudes de cas avec contexte, problematique, solution apportee et resultats chiffres. Les temoignages clients sont mis en valeur pour renforcer la credibilite.'
          },
          {
            q: 'Peut-on integrer un systeme de prise de rendez-vous pour les appels decouverte ?',
            a: 'Oui, j\'integre Calendly, Cal.com ou un formulaire sur mesure pour que vos prospects reservent un creneau d\'appel decouverte directement depuis votre site, sans echange de mails.'
          },
          {
            q: 'Combien coute un site web pour un consultant a Rennes ?',
            a: 'Un site vitrine pour consultant avec blog et prise de rendez-vous demarre autour de 700 euros. Le prix varie selon les fonctionnalites souhaitees (espace client, formations en ligne, etc.). Devis gratuit sur demande.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Pret a developper votre activite en ligne ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre activite et de vos objectifs. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
