---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web pour coach à Rennes",
      "provider": { "@id": "https://evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Développement web",
      "description": "Création de sites web pour coachs sportifs et bien-être à Rennes : réservation de créneaux, présentation des programmes, témoignages clients et booking en ligne.",
      "url": "https://evandavison.fr/services/site-web-coach-rennes"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Site web coach Rennes", "item": "https://evandavison.fr/services/site-web-coach-rennes" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Le site peut-il gérer la réservation de séances en ligne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, j'intègre un système de réservation en ligne (Calendly, Cal.com ou solution sur mesure) où vos clients choisissent un créneau, un type de séance et paient directement. Vous gérez votre planning sans échange de messages." }
        },
        {
          "@type": "Question",
          "name": "Peut-on afficher les témoignages et transformations de clients ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument. Une section dédiée aux témoignages avec photos avant/après (avec consentement), avis et résultats concrets. C'est le levier de conversion le plus puissant pour un coach." }
        },
        {
          "@type": "Question",
          "name": "Le site peut-il présenter mes différents programmes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, chaque programme ou formule a sa page dédiée avec description, durée, tarif et objectifs. Les visiteurs comprennent clairement ce que vous proposez et choisissent la formule adaptée." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un site web pour un coach sportif ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine pour coach avec réservation et présentation des programmes démarre autour de 800€. Le prix varie selon les fonctionnalités (paiement en ligne, espace client, blog). Devis gratuit." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Site web coach sportif Rennes | Evan Davison — Développeur Web"
  description="Création de site web pour coach sportif et bien-être à Rennes. Réservation en ligne, programmes, témoignages. Attirez plus de clients. Devis gratuit."
  canonical="https://evandavison.fr/services/site-web-coach-rennes"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Site web coach Rennes</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Un site de <em class="text-accent">coach</em> qui convertit<br/>les visiteurs en clients
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Reservation de seances, presentation de vos programmes, temoignages clients — un site web qui reflete votre energie et remplit votre agenda a Rennes.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">Obtenir un devis gratuit</a>
          <a href="/#realisations" class="btn-secondary">Voir mes realisations</a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Instagram ne remplace pas un vrai <em class="text-accent">site professionnel</em>
            </h2>
            <div class="space-y-4 text-text-body">
              <p>En tant que coach sportif ou bien-etre, votre presence sur Instagram est essentielle. Mais un profil Instagram ne permet pas de presenter clairement vos tarifs, vos programmes, ni de prendre des reservations sans echanges de DM interminables.</p>
              <p>Un site web professionnel centralise tout : vos offres, votre planning, vos temoignages, et un systeme de reservation qui fait gagner du temps a tout le monde. C'est la difference entre un amateur et un professionnel etabli.</p>
              <p>Je concois des sites pour coachs sportifs, preparateurs physiques, coachs en nutrition et bien-etre a Rennes. Des sites qui reflètent votre dynamisme tout en structurant votre activite.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Cherchent un coach en ligne', value: '73%' },
              { label: 'Veulent reserver en ligne', value: '64%' },
              { label: 'Lisent les temoignages', value: '88%' },
              { label: 'Comparent les programmes', value: '71%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalites specifiques -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Les fonctionnalites cles d'un site de <em class="text-accent">coaching</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Reservation de creneaux', desc: "Systeme de booking en ligne avec choix du type de seance, du creneau et paiement integre. Fini les allers-retours par message." },
          { title: 'Presentation des programmes', desc: "Pages dediees par programme : objectifs, duree, frequence, tarif. Chaque visiteur trouve la formule qui lui correspond." },
          { title: 'Temoignages et resultats', desc: "Section transformations avec photos avant/apres, temoignages video ou ecrits. La preuve sociale qui convainc les indecis." },
          { title: 'Blog et conseils', desc: "Articles sur la nutrition, l'entrainement, le bien-etre. Du contenu qui positionne votre expertise et ameliore votre referencement Google." },
          { title: 'Grille tarifaire claire', desc: "Presentation transparente de vos tarifs par formule : seance unique, pack, abonnement. Les prospects savent a quoi s'attendre." },
          { title: 'Lien reseaux sociaux', desc: "Integration de votre feed Instagram et liens vers vos reseaux. Votre site et vos reseaux se renforcent mutuellement." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Realisations CTA -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Des sites qui <em class="text-accent">motivent a passer a l'action</em>
        </h2>
        <p class="text-text-body mb-8">Decouvrez des projets realises pour des professionnels du coaching et du sport.</p>
        <a href="/#realisations" class="btn-primary">Voir toutes mes realisations</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Le site peut-il gerer la reservation de seances en ligne ?',
            a: 'Oui, j\'integre un systeme de reservation en ligne (Calendly, Cal.com ou solution sur mesure) ou vos clients choisissent un creneau, un type de seance et paient directement. Vous gerez votre planning sans echange de messages.'
          },
          {
            q: 'Peut-on afficher les temoignages et transformations de clients ?',
            a: 'Absolument. Une section dediee aux temoignages avec photos avant/apres (avec consentement), avis et resultats concrets. C\'est le levier de conversion le plus puissant pour un coach.'
          },
          {
            q: 'Le site peut-il presenter mes differents programmes ?',
            a: 'Oui, chaque programme ou formule a sa page dediee avec description, duree, tarif et objectifs. Les visiteurs comprennent clairement ce que vous proposez et choisissent la formule adaptee.'
          },
          {
            q: 'Combien coute un site web pour un coach sportif ?',
            a: 'Un site vitrine pour coach avec reservation et presentation des programmes demarre autour de 800 euros. Le prix varie selon les fonctionnalites (paiement en ligne, espace client, blog). Devis gratuit.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Pret a remplir votre agenda de coaching ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Parlons de votre activite et de vos objectifs. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
