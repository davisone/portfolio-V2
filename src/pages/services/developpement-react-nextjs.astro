---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Developpement React et Next.js a Rennes",
      "provider": { "@id": "https://evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Rennes" },
      "serviceType": "Developpement front-end React / Next.js",
      "description": "Developpement d'applications web performantes avec React et Next.js a Rennes. SSR, SSG, App Router, TypeScript. Sites rapides, SEO-friendly et maintenables.",
      "url": "https://evandavison.fr/services/developpement-react-nextjs"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Developpement React / Next.js", "item": "https://evandavison.fr/services/developpement-react-nextjs" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi choisir React pour mon application web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "React est la bibliothèque front-end la plus utilisée au monde. Son écosystème mature, sa communauté active et son modèle de composants réutilisables permettent de créer des interfaces rapides, interactives et maintenables sur le long terme." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre React et Next.js ?",
          "acceptedAnswer": { "@type": "Answer", "text": "React est une bibliothèque d'interface utilisateur. Next.js est un framework complet construit sur React qui ajoute le rendu serveur (SSR), la génération statique (SSG), le routage, l'optimisation d'images et bien plus. Next.js est idéal pour les sites qui ont besoin d'un bon SEO et de performances maximales." }
        },
        {
          "@type": "Question",
          "name": "Un site Next.js est-il bon pour le SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, c'est l'un de ses points forts. Grâce au Server-Side Rendering et à la génération statique, les pages sont servies en HTML complet aux moteurs de recherche. Combiné aux balises meta, aux données structurées et à l'optimisation des Core Web Vitals, Next.js offre une base SEO excellente." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte le développement d'une application React / Next.js ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le tarif dépend de la complexité : un site vitrine Next.js démarre autour de 1 200€, une application web avec authentification et base de données à partir de 2 500€. Un devis gratuit est établi après analyse de votre besoin." }
        },
        {
          "@type": "Question",
          "name": "Utilisez-vous TypeScript avec React ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, TypeScript est systématiquement utilisé sur tous mes projets React et Next.js. Le typage statique réduit les bugs, améliore l'autocomplétion et rend le code plus fiable et maintenable, surtout sur les projets qui grandissent." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Developpeur React et Next.js Rennes | Evan Davison"
  description="Developpeur React et Next.js freelance a Rennes. Applications web performantes, SSR, SSG, TypeScript. Sites rapides, maintenables et optimises SEO. Devis gratuit."
  canonical="https://evandavison.fr/services/developpement-react-nextjs"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Developpement React / Next.js</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Developpeur <em class="text-accent">React</em> et <em class="text-accent">Next.js</em><br/>a Rennes
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Vous cherchez un developpeur React pour construire une application web rapide, maintenable et bien referencee ? Je concois des interfaces modernes avec Next.js, TypeScript et les meilleures pratiques du web.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Discuter de votre projet
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes realisations
          </a>
        </div>
      </div>
    </section>

    <!-- Probleme / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              Des applications web qui <em class="text-accent">tiennent la route</em>
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Votre application front-end est lente, difficile a maintenir ou mal referencee ? Un code React mal structure aujourd'hui, c'est une dette technique demain.</p>
              <p>Je developpe des applications React et Next.js pensees pour durer : architecture en composants reutilisables, rendu serveur pour le SEO, typage strict avec TypeScript, et performances optimisees pour les Core Web Vitals.</p>
              <p>App Router, Server Components, Incremental Static Regeneration — j'utilise les fonctionnalites de Next.js qui font vraiment la difference pour votre projet, pas celles qui sont a la mode.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Projets React livres', value: '15+' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'TypeScript strict', value: '100%' },
              { label: 'Temps de build moyen', value: '<30s' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Technologies -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Stack <em class="text-accent">technique</em>
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'React 19', desc: "Composants fonctionnels, hooks personnalises, Server Components. Architecture modulaire et reutilisable." },
          { title: 'Next.js (App Router)', desc: "SSR, SSG, ISR, middleware, API Routes. Le framework fullstack de reference pour la production." },
          { title: 'TypeScript strict', desc: "Typage statique sur tout le codebase. Moins de bugs, meilleure DX, refactoring en confiance." },
          { title: 'Tailwind CSS', desc: "Stylisation utilitaire, design systems coherents, zero CSS inutilise en production." },
          { title: 'Zustand + TanStack Query', desc: "Gestion d'etat legere et cache serveur intelligent. Performant sans la complexite de Redux." },
          { title: 'Vercel / Node.js', desc: "Deploiement optimise, edge functions, analytics integres. Infrastructure pensee pour Next.js." },
        ].map(item => (
          <div class="border border-border p-6">
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
          Comment je <em class="text-accent">travaille</em>
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { step: '01', title: 'Cadrage', desc: "Analyse de vos besoins, choix d'architecture (SSR, SSG, SPA), definition du scope technique." },
            { step: '02', title: 'Prototypage', desc: "Maquette et structure de composants. Validation de l'UX et du routing avant le code." },
            { step: '03', title: 'Developpement', desc: "Code React/Next.js en TypeScript strict. Tests, revues de code, deploiement continu." },
            { step: '04', title: 'Livraison', desc: "Deploiement sur Vercel ou votre infra, documentation technique, formation si necessaire." },
          ].map(item => (
            <div class="border border-border p-6">
              <div class="text-4xl font-serif font-black text-border/50 mb-3">{item.step}</div>
              <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Realisations liees -->
    <section class="section-container py-16 sm:py-24 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
        Projets <em class="text-accent">React / Next.js</em>
      </h2>
      <p class="text-text-body mb-8">Des applications web concretes construites avec React et Next.js.</p>
      <a href="/#realisations" class="btn-primary">
        Voir toutes mes realisations
      </a>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
          Questions <em class="text-accent">frequentes</em>
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {[
            {
              q: 'Pourquoi choisir React pour mon application web ?',
              a: "React est la bibliotheque front-end la plus utilisee au monde. Son ecosysteme mature, sa communaute active et son modele de composants reutilisables permettent de creer des interfaces rapides et maintenables sur le long terme."
            },
            {
              q: 'Quelle est la difference entre React et Next.js ?',
              a: "React est une bibliotheque d'interface utilisateur. Next.js est un framework complet construit sur React qui ajoute le rendu serveur (SSR), la generation statique (SSG), le routage, l'optimisation d'images et bien plus. Next.js est ideal pour les sites qui ont besoin d'un bon SEO."
            },
            {
              q: 'Un site Next.js est-il bon pour le SEO ?',
              a: "Oui, c'est l'un de ses points forts. Grace au Server-Side Rendering et a la generation statique, les pages sont servies en HTML complet aux moteurs de recherche. Combine aux balises meta, aux donnees structurees et a l'optimisation des Core Web Vitals, Next.js offre une base SEO excellente."
            },
            {
              q: "Combien coute le developpement d'une application React / Next.js ?",
              a: "Le tarif depend de la complexite : un site vitrine Next.js demarre autour de 1 200 euros, une application web avec authentification et base de donnees a partir de 2 500 euros. Un devis gratuit est etabli apres analyse de votre besoin."
            },
            {
              q: 'Utilisez-vous TypeScript avec React ?',
              a: "Oui, TypeScript est systematiquement utilise sur tous mes projets React et Next.js. Le typage statique reduit les bugs, ameliore l'autocompletion et rend le code plus fiable et maintenable, surtout sur les projets qui grandissent."
            },
          ].map(item => (
            <details class="border border-border p-6 group">
              <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
                {item.q}
                <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Un projet React ou Next.js en tete ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Discutons de votre application. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour a l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
