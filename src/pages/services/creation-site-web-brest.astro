---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création site web à Brest",
      "provider": { "@id": "https://www.evandavison.fr/#person" },
      "areaServed": { "@type": "City", "name": "Brest" },
      "serviceType": "Développement web",
      "description": "Développeur web freelance pour les entreprises brestoises : sites vitrines, applications web et e-commerce. Technologies modernes, performances et SEO.",
      "url": "https://www.evandavison.fr/services/creation-site-web-brest"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://www.evandavison.fr" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.evandavison.fr/#services" },
        { "@type": "ListItem", "position": 3, "name": "Création site web Brest", "item": "https://www.evandavison.fr/services/creation-site-web-brest" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Travaillez-vous avec des entreprises du secteur maritime à Brest ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, Brest étant un pôle majeur de l'économie maritime, j'ai l'habitude de travailler avec des entreprises liées à la mer : chantiers navals, équipementiers, entreprises d'océanographie. Je crée des sites adaptés à ces secteurs techniques." }
        },
        {
          "@type": "Question",
          "name": "Comment se passent les échanges si vous êtes basé près de Rennes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Je travaille en visioconférence pour les échanges courants et me déplace à Brest pour les rendez-vous importants. Le train Rennes-Brest prend environ 2h. La distance n'est jamais un frein à la qualité du suivi." }
        },
        {
          "@type": "Question",
          "name": "Pouvez-vous créer un site multilingue pour une entreprise brestoise tournée vers l'international ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je développe des sites multilingues (français, anglais, et autres langues sur demande) avec une architecture SEO adaptée à chaque marché. Idéal pour les entreprises brestoises qui exportent ou travaillent avec des partenaires internationaux." }
        },
        {
          "@type": "Question",
          "name": "Quel budget prévoir pour un site web à Brest ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine démarre à partir de 800 euros, un e-commerce à partir de 1 500 euros. Pour les projets techniques plus complexes (portails métier, applications web), le budget est défini sur devis après analyse de vos besoins spécifiques." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous un hébergement et une maintenance pour les sites brestois ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, je propose des forfaits d'hébergement performant et de maintenance mensuelle : mises à jour de sécurité, sauvegardes automatiques, monitoring des performances et corrections. Votre site reste rapide et sécurisé dans le temps." }
        }
      ]
    }
  ]
}
---

<Layout
  title="Création site web Brest | Evan Davison — Développeur Web"
  description="Création de sites web à Brest : vitrines, applications web et e-commerce pour les entreprises du Finistère. Code performant, SEO intégré. Devis gratuit."
  canonical="https://www.evandavison.fr/services/creation-site-web-brest"
  schema={schema}
>
  <Header />

  <main id="main-content" class="pt-20">

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'ariane" class="section-container py-4">
      <ol class="flex items-center gap-2 text-sm text-muted">
        <li><a href="/" class="hover:text-ink transition-colors">Accueil</a></li>
        <li class="text-border">/</li>
        <li><a href="/#services" class="hover:text-ink transition-colors">Services</a></li>
        <li class="text-border">/</li>
        <li class="text-ink">Création site web Brest</li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="section-container py-16 sm:py-24">
      <div class="max-w-3xl">
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-ink mb-6 leading-tight">
          Création <em class="text-accent">site web</em><br/>à Brest
        </h1>
        <p class="text-xl text-text-body mb-8 leading-relaxed">
          Brest est un pole d'excellence dans le maritime, la defense et la recherche oceanographique. Que vous soyez une entreprise du technopole Brest-Iroise, un commerce de la rue de Siam ou un acteur du port de commerce, je concois des sites web a la hauteur de votre expertise — pas des pages generiques sans ame.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/#contact" class="btn-primary">
            Obtenir un devis gratuit
          </a>
          <a href="/#realisations" class="btn-secondary">
            Voir mes réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Problème / Solution -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-6">
              La pointe de la <em class="text-accent">Bretagne merite mieux</em> qu'un template
            </h2>
            <div class="space-y-4 text-text-body">
              <p>Le tissu economique brestois est riche et diversifie : industrie navale, recherche scientifique, numerique, commerce de detail. Pourtant, beaucoup d'entreprises locales se contentent de sites vieillissants qui ne refletent pas leur savoir-faire.</p>
              <p>Je developpe des sites sur mesure qui repondent aux enjeux de chaque secteur : vitrine technique pour un equipementier naval, site e-commerce pour un producteur finisterien, ou application web pour une startup du technopole. Chaque projet est unique.</p>
              <p>Depuis Rennes, j'interviens a Brest en visio et en presentiel. La collaboration est fluide, avec des points d'etape reguliers et une livraison dans les delais.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Projets livrés', value: '20+' },
              { label: 'Délai moyen', value: '3-4 sem.' },
              { label: 'Score Lighthouse', value: '95+' },
              { label: 'Clients satisfaits', value: '100%' },
            ].map(stat => (
              <div class="border border-border p-6 text-center">
                <div class="text-3xl font-serif font-bold text-accent mb-1">{stat.value}</div>
                <div class="text-muted text-sm">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Comment ça <em class="text-accent">se passe</em> ?
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Briefing', desc: "Echange approfondi sur votre activite, votre secteur et vos objectifs. On definit ensemble le perimetre du projet." },
          { step: '02', title: 'Conception', desc: "Maquette personnalisee, architecture technique adaptee a votre metier et strategie SEO pour le marche brestois." },
          { step: '03', title: 'Production', desc: "Developpement avec des technologies modernes. Code propre, performant, et suivi transparent a chaque etape." },
          { step: '04', title: 'Deploiement', desc: "Mise en production, optimisation SEO local Finistere, formation et support technique post-lancement." },
        ].map(item => (
          <div class="border border-border p-6">
            <div class="text-4xl font-serif font-black text-border/50 mb-3">{item.step}</div>
            <h3 class="text-ink font-semibold text-lg mb-2">{item.title}</h3>
            <p class="text-text-body text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Réalisations liées -->
    <section class="py-16 bg-paper-alt border-t border-b border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Quelques <em class="text-accent">realisations</em>
        </h2>
        <p class="text-text-body mb-8">Des projets concrets pour des entreprises bretonnes, du Finistere a l'Ille-et-Vilaine.</p>
        <a href="/#realisations" class="btn-primary">
          Voir toutes mes réalisations
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-container py-16 sm:py-24">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-12 text-center">
        Questions <em class="text-accent">frequentes</em>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        {[
          {
            q: 'Travaillez-vous avec des entreprises du secteur maritime ?',
            a: 'Oui, Brest etant un pole majeur de l\'economie maritime, je travaille avec des entreprises liees a la mer : chantiers navals, equipementiers, oceanographie. Je cree des sites adaptes a ces secteurs techniques.'
          },
          {
            q: 'Comment se passent les echanges si vous etes base pres de Rennes ?',
            a: 'Les echanges courants se font en visio, et je me deplace a Brest pour les rendez-vous importants. Le train Rennes-Brest prend environ 2h. La distance n\'est jamais un frein a la qualite du suivi.'
          },
          {
            q: 'Pouvez-vous creer un site multilingue pour une entreprise brestoise ?',
            a: 'Oui, je developpe des sites multilingues avec une architecture SEO adaptee a chaque marche. Ideal pour les entreprises brestoises qui exportent ou travaillent avec des partenaires internationaux.'
          },
          {
            q: 'Quel budget prevoir pour un site web a Brest ?',
            a: 'Un site vitrine demarre a 800 euros, un e-commerce a partir de 1 500 euros. Pour les projets techniques complexes (portails metier, applications web), le budget est defini sur devis apres analyse de vos besoins.'
          },
          {
            q: 'Proposez-vous hebergement et maintenance ?',
            a: 'Oui, je propose des forfaits d\'hebergement performant et de maintenance mensuelle : mises a jour de securite, sauvegardes automatiques, monitoring et corrections. Votre site reste rapide et securise.'
          },
        ].map(item => (
          <details class="border border-border p-6 group">
            <summary class="text-ink font-medium cursor-pointer list-none flex items-center justify-between gap-4">
              {item.q}
              <span class="text-accent shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-text-body mt-4 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA Contact -->
    <section class="py-16 bg-paper-alt border-t border-border">
      <div class="section-container text-center">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink mb-4">
          Un projet web a Brest ?
        </h2>
        <p class="text-text-body mb-8 max-w-xl mx-auto">
          Echangeons sur votre besoin en visio ou lors d'un deplacement a Brest. Premier echange gratuit, sans engagement.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn-primary">Me contacter</a>
          <a href="/" class="btn-secondary">Retour à l'accueil</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  details[open] summary span {
    transform: rotate(45deg);
  }
</style>
