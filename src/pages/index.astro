---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import About from '../components/About.jsx'
import Services from '../components/Services.jsx'
import Experience from '../components/Experience.jsx'
import Projects from '../components/Projects.jsx'
import Contact from '../components/Contact.jsx'
import ScrollToTop from '../components/ScrollToTop.jsx'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Evan Davison | Développeur Fullstack & Alternance Chef de projet IT — Rennes"
  description="Portfolio d'Evan Davison, développeur fullstack à Rennes et fondateur de DVS Web. En recherche d'alternance en gestion de projet IT. Spécialisé React, Next.js, TypeScript, Flutter."
  canonical="https://www.evandavison.fr"
  ogType="profile"
  keywords="développeur fullstack Rennes, développeur web Rennes, React, Next.js, TypeScript, Flutter, DVS Web, création site web, portfolio développeur"
  hasTranslations
  locale="fr"
>
  <div class="min-h-screen">
    <Header locale="fr" />
    <main id="main-content">
      <Hero locale="fr" />
      <About locale="fr" client:visible />
      <Services locale="fr" client:visible />
      <Experience locale="fr" client:visible />
      <Projects locale="fr" client:visible />
      <Contact locale="fr" client:visible />
    </main>
    <Footer locale="fr" />
    <ScrollToTop client:load />
  </div>
</Layout>
