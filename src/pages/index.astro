---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import SalleHall from '../components/galerie/SalleHall.astro'
import SalleAPropos from '../components/galerie/SalleAPropos.astro'
import SalleServices from '../components/galerie/SalleServices.astro'
import GrandeSalle from '../components/galerie/GrandeSalle.astro'
import SalleExperience from '../components/galerie/SalleExperience.astro'
import SalleSortie from '../components/galerie/SalleSortie.astro'
import EntreeGalerie from '../components/galerie/EntreeGalerie.astro'
---

<Layout
  title="Evan Davison | Développeur Web Fullstack à Rennes"
  description="Portfolio d'Evan Davison, développeur fullstack à Rennes et fondateur de DVS Web. En master développement web et développeur fullstack en alternance. Spécialisé React, Next.js, TypeScript, Flutter."
  canonical="https://www.evandavison.fr/"
  ogType="profile"
  keywords="développeur fullstack Rennes, développeur web Rennes, React, Next.js, TypeScript, Flutter, DVS Web, création site web, portfolio développeur"
  hasTranslations
  locale="fr"
>
  <Header locale="fr" />
  <EntreeGalerie locale="fr" />
  <main id="main-content" class="galerie-viewport">
    <div class="galerie-monde">
      <SalleHall locale="fr" />
      <SalleAPropos locale="fr" />
      <SalleServices locale="fr" />
      <GrandeSalle locale="fr" />
      <SalleExperience locale="fr" />
      <SalleSortie locale="fr" />
    </div>
  </main>
  <Footer locale="fr" />
</Layout>

<script>
  import "../scripts/galerie.js"
</script>
