---
import '../styles/global.css'
import { type Locale } from '../i18n'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  schema?: object
  noindex?: boolean
  locale?: Locale
}

const {
  title = 'Evan Davison | Développeur Fullstack Rennes - Portfolio',
  description = "Portfolio d'Evan Davison, développeur fullstack à Rennes. Découvrez mes projets, compétences (React, Next.js, Flutter, Node.js) et mon parcours. Fondateur de DVS Web.",
  canonical = 'https://evandavison.fr',
  ogImage = 'https://evandavison.fr/og-image.jpg',
  schema,
  noindex = false,
  locale = 'fr',
} = Astro.props

const today = new Date().toISOString().split('T')[0]
---

<!DOCTYPE html>
<html lang={locale === 'en-gb' || locale === 'en-us' ? 'en' : locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="fr" href={`https://evandavison.fr${Astro.url.pathname.replace(/^\/(en-gb|en-us)/, '')}`} />
    <link rel="alternate" hreflang="en-GB" href={`https://evandavison.fr/en-gb${Astro.url.pathname.replace(/^\/(en-gb|en-us)/, '')}`} />
    <link rel="alternate" hreflang="en-US" href={`https://evandavison.fr/en-us${Astro.url.pathname.replace(/^\/(en-gb|en-us)/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`https://evandavison.fr${Astro.url.pathname.replace(/^\/(en-gb|en-us)/, '')}`} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
<meta name="author" content="Evan Davison" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonical} />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="FR-35" />
    <meta name="geo.placename" content="Rennes, Bretagne, France" />
    <meta name="geo.position" content="48.1173;-1.6778" />
    <meta name="ICBM" content="48.1173, -1.6778" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Evan Davison - Portfolio" />
    <meta property="profile:first_name" content="Evan" />
    <meta property="profile:last_name" content="Davison" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org Person + Portfolio -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://evandavison.fr/#person",
          "name": "Evan Davison",
          "givenName": "Evan",
          "familyName": "Davison",
          "jobTitle": "Développeur Fullstack & Chef de projet IT (alternance)",
          "description": "Développeur fullstack basé à Rennes, spécialisé en React, Next.js, TypeScript, Node.js et Flutter. Fondateur de DVS Web. En recherche d'alternance en gestion de projet IT.",
          "url": "https://evandavison.fr",
          "email": "contact@evandavison.fr",
          "telephone": "+33651019506",
          "image": "https://evandavison.fr/og-image.jpg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Rennes",
            "addressRegion": "Bretagne",
            "addressCountry": "FR"
          },
          "alumniOf": {
            "@type": "EducationalOrganization",
            "name": "Sup de Vinci",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Chantepie",
              "addressRegion": "Bretagne"
            }
          },
          "knowsAbout": [
            "Développement web", "React", "Next.js", "TypeScript", "JavaScript",
            "Node.js", "Flutter", "Dart", "Tailwind CSS", "PostgreSQL",
            "MongoDB", "Firebase", "SEO", "UI/UX Design",
            "Gestion de projet IT", "Pilotage de projets informatiques", "Coordination d'équipes"
          ],
          "sameAs": [
            "https://github.com/davisone",
            "https://www.linkedin.com/in/evan-d-766478247",
            "https://dvs-web.fr"
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "DVS Web",
            "url": "https://dvs-web.fr"
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://evandavison.fr/#website",
          "url": "https://evandavison.fr",
          "name": "Evan Davison - Portfolio Développeur Fullstack",
          "description": "Portfolio et CV en ligne d'Evan Davison, développeur fullstack à Rennes",
          "publisher": { "@id": "https://evandavison.fr/#person" },
          "inLanguage": "fr-FR"
        },
        {
          "@type": "ProfilePage",
          "@id": "https://evandavison.fr/#profilepage",
          "url": "https://evandavison.fr",
          "name": "Portfolio d'Evan Davison",
          "mainEntity": { "@id": "https://evandavison.fr/#person" },
          "dateCreated": "2026-01-28",
          "dateModified": today,
          "inLanguage": "fr-FR"
        },
        {
          "@type": "BreadcrumbList",
          "@id": "https://evandavison.fr/#breadcrumb",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://evandavison.fr" }
          ]
        }
      ]
    })} />

    <!-- Schema.org additionnel par page -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google Analytics (differe apres le premier paint) -->
    <script is:inline>
      (function() {
        function loadGA() {
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZS8DC81PH4';
          s.async = true;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-ZS8DC81PH4');
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA);
        } else {
          setTimeout(loadGA, 2000);
        }
      })();
    </script>
    <!-- Theme detection (avant le body pour eviter le flash) -->
    <script is:inline>
      (function() {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink focus:text-paper focus:outline-none">
      Aller au contenu principal
    </a>
    <slot />
  </body>
</html>
