{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:lang(en-us|en-gb)/glossaire/:term(core-web-vitals|schema-org|oauth|saas|mvp)/",
      "destination": "/glossaire/",
      "permanent": true
    },
    {
      "source": "/glossaire/:term(core-web-vitals|schema-org|oauth|saas|mvp)/",
      "destination": "/glossaire/",
      "permanent": true
    },
    {
      "source": "/:lang(en-us|en-gb)/:path([a-z0-9][a-z0-9/-]*)/",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/services/:page(hebergement-web|maintenance-web)/",
      "destination": "https://www.dvs-web.fr/tarifs",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/cv-evan-davison.pdf",
      "destination": "/cv/Evan_Davison_cv.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/sitemap-0.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}
